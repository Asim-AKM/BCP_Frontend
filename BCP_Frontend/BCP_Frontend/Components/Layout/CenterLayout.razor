@inherits LayoutComponentBase

<div class="admin-canvas text-slate-100 h-screen flex flex-col font-sans overflow-hidden">
    <!-- Header -->
    <header class="sticky top-0 z-40 bg-surface/95 backdrop-blur-md text-white border-b border-line h-16 flex items-center justify-between px-4 sm:px-6 shrink-0">
        <div class="flex items-center gap-3">
            <!-- Hamburger Button (Blazor C# Click Event) -->
            <button @onclick="ToggleSidebar" class="lg:hidden text-slate-400 hover:text-white p-2 rounded-xl focus:outline-none hover:bg-surface3 transition-all" aria-label="Toggle Navigation">
                @if (isSidebarOpen)
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                }
                else
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                }
            </button>
            <a href="/" class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-blood-500 to-blood-900 flex items-center justify-center text-white text-sm shadow-lg shadow-blood-900/40">🩸</div>
                <span class="font-display text-base font-bold tracking-tight">BloodConnect<span class="text-blood-500">.pk</span></span>
            </a>
            <span class="bg-ice-500/10 text-ice-400 text-[10px] font-extrabold px-2.5 py-0.5 rounded-full border border-ice-500/25 hidden sm:inline-block tracking-wide">CENTER ADMIN</span>
        </div>
        <div class="flex items-center gap-3 sm:gap-4">
            <span class="bg-vital-500/10 text-vital-400 text-[11px] sm:text-xs font-bold px-2.5 py-1 rounded-full border border-vital-500/25 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-vital-500 animate-pulse"></span>
                <span class="hidden sm:inline">14-Day Trial Active</span><span class="sm:hidden">Trial</span>
            </span>
            <a href="/logout" class="text-xs font-semibold text-slate-400 hover:text-white transition-colors">Logout</a>
        </div>
    </header>

    <!-- Main Section Wrapper -->
    <div class="flex flex-1 overflow-hidden relative">
        <!-- Mobile Overlay Backdrop -->
        @if (isSidebarOpen)
        {
            <div @onclick="ToggleSidebar" class="fixed inset-0 bg-ink/70 z-20 lg:hidden backdrop-blur-sm"></div>
        }

        <!-- Sidebar Component (Passes Mobile Drawer State) -->
        <CenterSidebar IsOpen="@isSidebarOpen" OnLinkClick="CloseSidebar" />

        <!-- Scrollable Main Content -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isSidebarOpen = false;

    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;
    private void CloseSidebar() => isSidebarOpen = false;
}