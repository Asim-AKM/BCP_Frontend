@inherits LayoutComponentBase
@using BCP_Frontend.Components.Layout

<div class="bg-[#050811] text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-red-600 selection:text-white">

    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-40 bg-[#090d1a]/95 backdrop-blur-md text-white border-b border-[#182032] h-16 flex items-center justify-between px-4 sm:px-6">
        <div class="flex items-center gap-3">
            <button @onclick="ToggleSidebar" class="lg:hidden text-slate-400 hover:text-white p-2 rounded-xl focus:outline-none hover:bg-[#121826] transition-all" aria-label="Toggle Navigation">
                @if (isSidebarOpen)
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                }
                else
                {
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                }
            </button>
            <NavLink href="/center/dashboard" class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-red-600 to-red-900 flex items-center justify-center text-white text-sm shadow-md shadow-red-900/40">🩸</div>
                <span class="font-extrabold text-base tracking-tight text-white">BloodConnect<span class="text-red-500">.pk</span></span>
            </NavLink>
            <span class="bg-cyan-500/10 text-cyan-400 text-[10px] font-black px-2.5 py-0.5 rounded border border-cyan-500/20 uppercase tracking-wider hidden sm:inline-block">CENTER ADMIN</span>
        </div>
        <div class="flex items-center gap-4">
            <span class="bg-emerald-500/10 text-emerald-400 text-xs font-bold px-3 py-1 rounded-full border border-emerald-500/20 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                <span>14-Day Trial Active</span>
            </span>
            <NavLink href="auth/login" class="text-xs font-semibold text-slate-400 hover:text-white transition-colors">Logout</NavLink>
        </div>
    </header>

    <!-- Workspace Body -->
    <div class="flex flex-1 overflow-hidden relative">
        @if (isSidebarOpen)
        {
            <div @onclick="CloseSidebar" class="fixed inset-0 bg-slate-950/70 z-20 lg:hidden backdrop-blur-sm transition-opacity"></div>
        }

        <CenterSidebar IsOpen="@isSidebarOpen" OnClose="CloseSidebar" />

        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-6 space-y-6 bg-[#050811]">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isSidebarOpen = false;

    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;
    private void CloseSidebar() => isSidebarOpen = false;
}