@inject NavigationManager Navigation

<aside class="fixed lg:static top-16 lg:top-0 left-0 bottom-0 w-64 bg-surface border-r border-line z-30 transform @(IsOpen ? "translate-x-0" : "-translate-x-full lg:translate-x-0") transition-transform duration-200 ease-in-out flex flex-col justify-between overflow-y-auto h-full">
    <div class="p-4 space-y-6">
        <!-- Active Center Info Badge -->
        <div class="p-3 bg-surface2 rounded-xl border border-line">
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Active Center</p>
            <p class="text-xs font-bold text-white truncate mt-0.5">Shifa Hospital Blood Bank</p>
            <p class="text-[10px] font-mono text-slate-500">ISB-MAIN-01</p>
        </div>

        <!-- Navigation Links -->
        <nav class="space-y-1 font-semibold text-xs text-slate-300">
            <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-600 px-3 mb-2">Main Menu</p>

            <NavLink href="center/dashboard" Match="NavLinkMatch.All"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-xl border border-transparent transition-all hover:bg-surface3 hover:text-white"
                     ActiveClass="nav-link-active" @onclick="HandleNavClick">
                <span>📊</span> Dashboard
            </NavLink>

            <NavLink href="center/stock"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-xl border border-transparent transition-all hover:bg-surface3 hover:text-white"
                     ActiveClass="nav-link-active" @onclick="HandleNavClick">
                <span>🩸</span> Stock Management
            </NavLink>

            <NavLink href="center/requests"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-xl border border-transparent transition-all hover:bg-surface3 hover:text-white justify-between"
                     ActiveClass="nav-link-active" @onclick="HandleNavClick">
                <span class="flex items-center gap-3"><span>🚨</span> Requests</span>
                <span class="bg-signal-500 text-slate-950 text-[10px] font-extrabold px-1.5 py-0.5 rounded-md">2</span>
            </NavLink>

            <NavLink href="center/dispatch"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-xl border border-transparent transition-all hover:bg-surface3 hover:text-white"
                     ActiveClass="nav-link-active" @onclick="HandleNavClick">
                <span>📋</span> Dispatch History
            </NavLink>

            <NavLink href="center/donors"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-xl border border-transparent transition-all hover:bg-surface3 hover:text-white"
                     ActiveClass="nav-link-active" @onclick="HandleNavClick">
                <span>👥</span> Donor Registry
            </NavLink>

            <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-600 px-3 pt-4 mb-2">Management</p>

            <NavLink href="center/settings"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-xl border border-transparent transition-all hover:bg-surface3 hover:text-white"
                     ActiveClass="nav-link-active" @onclick="HandleNavClick">
                <span>⚙️</span> Center Settings
            </NavLink>

            <NavLink href="center/billing"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-xl border border-transparent transition-all hover:bg-surface3 hover:text-white"
                     ActiveClass="nav-link-active" @onclick="HandleNavClick">
                <span>💳</span> Billing & SaaS Plan
            </NavLink>
        </nav>
    </div>

    <!-- Active User Profile Footer -->
    <div class="p-4 border-t border-line bg-surface">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-blood-900/50 border border-blood-700/50 flex items-center justify-center font-bold text-blood-200 text-xs">SK</div>
            <div class="overflow-hidden">
                <p class="text-xs font-bold text-white truncate">Dr. Sarah Khan</p>
                <p class="text-[10px] font-medium text-slate-500 truncate">admin@shifahospital.org</p>
            </div>
        </div>
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task HandleNavClick()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}