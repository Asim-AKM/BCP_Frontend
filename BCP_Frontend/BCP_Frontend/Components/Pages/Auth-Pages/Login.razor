@using BCP_Frontend.Components.Layout
@page "/auth/login"
@layout EmptyLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="min-h-screen w-full flex items-center justify-center p-4 bg-slate-950 selection:bg-blood-600 selection:text-white">
    
    <!-- Outer Frame Box with 90% Zoom for perfect fit without scrolling -->
    <div class="w-full max-w-5xl min-h-[580px] bg-gradient-to-br from-slate-900 via-slate-950 to-blood-950/80 rounded-3xl border border-white/10 shadow-2xl overflow-hidden relative flex flex-col lg:flex-row my-auto" style="zoom: 0.9;">
        
        <!-- Background Ambient Glows -->
        <div class="absolute -top-24 -left-24 w-80 h-80 bg-blood-800/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- LEFT COLUMN: Brand Hero & 3D Artwork -->
        <div class="lg:w-1/2 p-6 lg:p-10 flex flex-col justify-between relative z-10 border-b lg:border-b-0 lg:border-r border-white/5">
            
            <!-- Top Left Decorative 3D Vector Graphic -->
            <div class="absolute -top-10 -left-10 opacity-80 pointer-events-none hidden sm:block">
                <svg width="240" height="240" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M40 100C40 40 100 20 160 50C120 100 180 160 100 180C40 180 40 140 40 100Z" fill="url(#grad1)" opacity="0.8" />
                    <path d="M20 80C20 20 80 10 140 30C100 80 160 140 80 160C20 160 20 120 20 80Z" fill="url(#grad2)" opacity="0.5" />
                    <defs>
                        <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#be123c" />
                            <stop offset="100%" stop-color="#4a041f" />
                        </linearGradient>
                        <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#fb7185" />
                            <stop offset="100%" stop-color="#880e4f" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>

            <!-- Header Brand Logo -->
            <div class="flex items-center gap-3 pt-1">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blood-800 to-blood-600 flex items-center justify-center text-white text-lg shadow-lg shadow-blood-800/40 border border-white/20">
                    🩸
                </div>
                <div>
                    <span class="text-lg font-extrabold tracking-tight text-white block leading-none">BloodConnect<span class="text-blood-500">.pk</span></span>
                    <span class="text-[9px] font-bold text-slate-400 tracking-wider uppercase">Unified SaaS Network</span>
                </div>
            </div>

            <!-- Center Content Headline -->
            <div class="my-8 lg:my-0 space-y-3 max-w-md">
                <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-blood-950/80 border border-blood-600/30 text-blood-400 text-[11px] font-bold">
                    <span class="w-1.5 h-1.5 rounded-full bg-blood-500 animate-ping"></span>
                    Central Management Access
                </span>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight">
                    Powering Pakistan's Live Blood Emergency Grid
                </h1>
                <p class="text-xs text-slate-400 font-medium leading-relaxed">
                    Access real-time hospital stock synchronization, immediate request dispatch, and center administration tools.
                </p>
            </div>

            <!-- Footer Action Links -->
            <div class="flex flex-wrap items-center gap-2.5 pt-2">
                <NavLink href="" class="px-3.5 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-bold text-slate-300 transition-all">
                    &larr; Public Portal
                </NavLink>
                <NavLink href="#how-it-works" class="px-3 py-1.5 rounded-lg bg-transparent hover:bg-white/5 text-xs font-bold text-slate-400 transition-all">
                    System Architecture
                </NavLink>
            </div>
        </div>

        <!-- RIGHT COLUMN: Glassmorphic Floating Login Box -->
        <div class="lg:w-1/2 p-5 sm:p-8 flex items-center justify-center relative z-10">
            <div class="w-full max-w-sm bg-white/[0.04] backdrop-blur-2xl border border-white/10 rounded-2xl p-5 sm:p-6 shadow-2xl">
                
                <!-- Title & Role Switcher -->
                <div class="mb-5">
                    <h2 class="text-xl font-black text-white tracking-tight">Log In to Portal</h2>
                    <p class="text-[11px] text-slate-400 mt-0.5 font-medium">Select your role and authenticate your account</p>

                    <!-- Role Switcher Segment -->
                    <div class="grid grid-cols-2 gap-1 bg-slate-950/80 p-1 rounded-xl border border-white/10 mt-4">
                        <button type="button" @onclick='() => SetRole("center")' class="py-1.5 text-xs font-extrabold rounded-lg @(selectedRole == "center" ? "bg-blood-700 text-white shadow-md" : "text-slate-400 hover:text-white") transition-all cursor-pointer">
                            🏥 Center Admin
                        </button>
                        <button type="button" @onclick='() => SetRole("admin")' class="py-1.5 text-xs font-extrabold rounded-lg @(selectedRole == "admin" ? "bg-blood-700 text-white shadow-md" : "text-slate-400 hover:text-white") transition-all cursor-pointer">
                            🛡️ Super Admin
                        </button>
                    </div>
                </div>

                <!-- Form -->
                <EditForm Model="loginModel" OnValidSubmit="HandleLogin" class="space-y-3.5">
                    
                    <!-- Email Input -->
                    <div>
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Official Email</label>
                        <div class="relative">
                            <input type="email" @value="emailInput" required placeholder="@(selectedRole == "center" ? "admin@shifahospital.org" : "superadmin@bloodconnect.pk")" class="w-full bg-slate-900/80 border border-white/10 text-xs font-semibold text-white rounded-xl py-2.5 px-3 pl-9 outline-none focus:border-blood-500 focus:ring-1 focus:ring-blood-500 transition-all placeholder:text-slate-600">
                            <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" /></svg>
                        </div>
                    </div>

                    <!-- Password Input -->
                    <div>
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Your Password</label>
                        <div class="relative">
                            <input type="@(isPasswordVisible ? "text" : "password")" @value="passwordInput" required placeholder="••••••••••••" class="w-full bg-slate-900/80 border border-white/10 text-xs font-semibold text-white rounded-xl py-2.5 px-3 pl-9 pr-9 outline-none focus:border-blood-500 focus:ring-1 focus:ring-blood-500 transition-all placeholder:text-slate-600">
                            <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                            
                            <!-- Toggle Password Eye -->
                            <button type="button" @onclick="TogglePasswordVisibility" class="absolute right-3 top-2.5 text-slate-500 hover:text-white transition-colors cursor-pointer">
                                @if (isPasswordVisible)
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.05 10.05 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.027 10.027 0 01-4.132 5.411m0 0L21 21" /></svg>
                                }
                                else
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                }
                            </button>
                        </div>
                    </div>

                    <!-- Remember & Forgot Password -->
                    <div class="flex items-center justify-between text-[11px] pt-0.5">
                        <label class="flex items-center gap-1.5 cursor-pointer text-slate-400 font-semibold">
                            <input type="checkbox" class="rounded border-white/10 bg-slate-900 accent-blood-600 focus:ring-0">
                            Remember me
                        </label>
                        <a href="/auth/forgot-password" class="font-bold text-blood-400 hover:underline">Forgotten?</a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="w-full bg-gradient-to-r from-blood-700 to-blood-600 hover:from-blood-600 hover:to-blood-500 text-white font-extrabold text-xs py-3 rounded-xl shadow-lg shadow-blood-900/50 transition-all hover:scale-[1.01] active:scale-[0.99] mt-1 cursor-pointer">
                        Log In
                    </button>
                </EditForm>

                <!-- Footer Sign Up Prompt -->
                <div class="mt-5 pt-4 border-t border-white/10 text-center">
                    <p class="text-[11px] text-slate-400 font-medium">Don't have a registered center?</p>
                    <NavLink href="auth/register-center" class="inline-block mt-1.5 w-full py-2 rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 text-xs font-extrabold text-white transition-all text-center">
                        Register New Blood Center
                    </NavLink>
                </div>

            </div>
        </div>

    </div>
</div>

@code {
    private string selectedRole = "center";
    private string emailInput = "";
    private string passwordInput = "";
    private bool isPasswordVisible = false;
    private object loginModel = new();

    private void SetRole(string role)
    {
        selectedRole = role;
    }

    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
    }

    private void HandleLogin()
    {
        if (selectedRole == "center")
        {
            Navigation.NavigateTo("admin/dashboard");
        }
        else
        {
            Navigation.NavigateTo("admin/dashboard");
        }
    }
}