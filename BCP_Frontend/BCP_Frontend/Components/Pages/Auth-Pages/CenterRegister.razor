@page "/auth/center-register"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms


<main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 flex-1 w-full text-slate-100 font-sans">
    <!-- Header Section -->
    <div class="text-center mb-10">
        <span class="bg-vital-500/10 text-vital-400 border border-vital-500/25 text-xs font-black px-3.5 py-1 rounded-full uppercase tracking-wider">
            🎁 14-Day Free Trial Included
        </span>
        <h1 class="text-3xl sm:text-4xl font-display font-black text-white mt-3">Register Your Blood Center</h1>
        <p class="text-xs sm:text-sm text-slate-400 font-medium mt-1">Join Pakistan's unified real-time blood SaaS management network.</p>
    </div>

    <!-- Progress Steps Bar -->
    <div class="bg-surface p-4 rounded-2xl border border-line shadow-sm mb-8">
        <div class="flex items-center justify-between text-xs font-extrabold text-slate-400">
            <div class="flex items-center gap-2 @(currentStep >= 1 ? "text-blood-400" : "text-slate-500")">
                <span class="w-7 h-7 rounded-full @(currentStep >= 1 ? "bg-blood-500 text-white" : "bg-surface2 text-slate-400") flex items-center justify-center text-xs">1</span>
                <span class="hidden sm:inline">Admin User</span>
            </div>
            <div class="h-0.5 flex-1 bg-line mx-3"></div>
            <div class="flex items-center gap-2 @(currentStep >= 2 ? "text-blood-400" : "text-slate-500")">
                <span class="w-7 h-7 rounded-full @(currentStep >= 2 ? "bg-blood-500 text-white" : "bg-surface2 text-slate-400") flex items-center justify-center text-xs">2</span>
                <span class="hidden sm:inline">Blood Center Details</span>
            </div>
            <div class="h-0.5 flex-1 bg-line mx-3"></div>
            <div class="flex items-center gap-2 @(currentStep >= 3 ? "text-blood-400" : "text-slate-500")">
                <span class="w-7 h-7 rounded-full @(currentStep >= 3 ? "bg-blood-500 text-white" : "bg-surface2 text-slate-400") flex items-center justify-center text-xs">3</span>
                <span class="hidden sm:inline">SaaS Plan & Review</span>
            </div>
        </div>
    </div>

    <!-- Main Card Wrapper -->
    <div class="bg-surface rounded-2xl p-6 sm:p-10 shadow-xl border border-line">
        @if (isSubmittedSuccess)
        {
            <div class="text-center py-8 space-y-4">
                <div class="w-16 h-16 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-full flex items-center justify-center text-3xl mx-auto">
                    ✓
                </div>
                <h2 class="text-2xl font-bold text-white">Application Submitted!</h2>
                <p class="text-xs text-slate-400 max-w-md mx-auto leading-relaxed">
                    Your center registration and admin account payload have been logged successfully and sent for approval.
                </p>

                <div class="bg-surface2 p-4 rounded-xl border border-line text-xs max-w-md mx-auto text-left space-y-1 mt-4">
                    <p class="text-slate-400">Center Name: <span class="text-white font-semibold">@registrationModel.Name</span></p>
                    <p class="text-slate-400">Reg #: <span class="text-white font-semibold">@registrationModel.RegistrationNumber</span></p>
                    <p class="text-slate-400">Admin Email: <span class="text-white font-semibold">@registrationModel.Email</span></p>
                    <p class="text-slate-400">Status: <span class="text-amber-400 font-bold">Pending Review (Approved upon verification)</span></p>
                </div>

                <div class="pt-4 flex justify-center gap-4">
                    <button type="button" @onclick="GoToDashboard" class="bg-vital-500 hover:bg-vital-600 text-slate-950 font-extrabold text-sm px-6 py-3 rounded-xl shadow-lg transition-all cursor-pointer">
                        Go to Dashboard &rarr;
                    </button>
                </div>
            </div>
        }
        else
        {
            <EditForm Model="registrationModel" OnValidSubmit="HandleSubmit">
               

                @if (!string.IsNullOrEmpty(stepErrorMessage))
                {
                    <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold flex items-center gap-2">
                        <span>⚠️</span>
                        <span>@stepErrorMessage</span>
                    </div>
                }

                <!-- SECTION 1: Admin Credentials (User Entity) -->
                @if (currentStep == 1)
                {
                    <div class="space-y-6">
                        <div class="border-b border-line pb-3 flex justify-between items-center">
                            <div>
                                <h2 class="text-lg font-bold text-white">Step 1: Admin User Account</h2>
                                <p class="text-xs text-slate-400">Maps to <code class="text-blood-400">User</code> Entity (<code class="text-slate-300">FullName</code>, <code class="text-slate-300">Email</code>, <code class="text-slate-300">PhoneNumber</code>)</p>
                            </div>
                            <span class="text-xs text-slate-400 font-medium">Step 1 of 3</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Full Name (FullName) *</label>
                                <input type="text" @bind="registrationModel.FullName" @bind:event="oninput" placeholder="Dr. Sarah Khan" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                            </div>
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Official Email (Email) *</label>
                                <input type="email" @bind="registrationModel.Email" @bind:event="oninput" placeholder="admin@shifahospital.org" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Phone Number (PhoneNumber) *</label>
                                <input type="tel" @bind="registrationModel.PhoneNumber" @bind:event="oninput" placeholder="0300-1234567" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                            </div>
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Blood Group (Optional)</label>
                                <select @bind="registrationModel.BloodGroup" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                                    <option value="">-- Select Blood Group --</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Password *</label>
                                <input type="password" @bind="registrationModel.Password" @bind:event="oninput" placeholder="••••••••" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                            </div>
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Confirm Password *</label>
                                <input type="password" @bind="registrationModel.ConfirmPassword" @bind:event="oninput" placeholder="••••••••" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                            </div>
                        </div>

                        <button type="button" @onclick="GoToStep2" class="w-full bg-blood-600 hover:bg-blood-700 text-white font-extrabold text-sm py-4 rounded-xl shadow-lg shadow-blood-900/40 transition-all cursor-pointer flex items-center justify-center gap-2">
                            <span>Next: Blood Center Entity Details</span>
                            <span>&rarr;</span>
                        </button>
                    </div>
                }

                <!-- SECTION 2: Center Details (BloodCenter Entity) -->
                @if (currentStep == 2)
                {
                    <div class="space-y-6">
                        <div class="border-b border-line pb-3 flex justify-between items-center">
                            <div>
                                <h2 class="text-lg font-bold text-white">Step 2: Blood Center & License Info</h2>
                                <p class="text-xs text-slate-400">Maps to <code class="text-blood-400">BloodCenter</code> Entity Properties</p>
                            </div>
                            <span class="text-xs text-slate-400 font-medium">Step 2 of 3</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Center Name (Name) *</label>
                                <input type="text" @bind="registrationModel.Name" @bind:event="oninput" placeholder="Shifa Regional Blood Bank" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                            </div>
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Registration Number (RegistrationNumber) *</label>
                                <input type="text" @bind="registrationModel.RegistrationNumber" @bind:event="oninput" placeholder="REG-PBTA-2026-889" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                            </div>
                        </div>

                        <!-- File Upload -->
                        <div>
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Accreditation Document (DocumentUrl) *</label>
                            <div class="mt-1.5 border-2 border-dashed border-line hover:border-blood-500/50 bg-surface2 rounded-xl p-5 text-center transition-all relative">
                                <InputFile OnChange="HandleFileSelected" accept=".pdf,.png,.jpg,.jpeg" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" />

                                @if (string.IsNullOrEmpty(uploadedFileName))
                                {
                                    <div class="flex flex-col items-center justify-center space-y-2 pointer-events-none">
                                        <div class="w-10 h-10 rounded-full bg-surface3 flex items-center justify-center text-slate-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                            </svg>
                                        </div>
                                        <div class="text-xs text-slate-300 font-semibold">
                                            <span class="text-vital-400 underline">Click to upload document</span> or drag and drop
                                        </div>
                                        <p class="text-[10px] text-slate-500">Formats: PDF, PNG, JPG (Max: 5 MB)</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center justify-between bg-surface3 p-3 rounded-lg border border-line text-left z-20 relative">
                                        <div class="flex items-center gap-3 overflow-hidden">
                                            <div class="w-8 h-8 rounded-lg bg-blood-500/20 text-blood-400 flex items-center justify-center text-xs font-bold shrink-0">
                                                📄
                                            </div>
                                            <div class="truncate">
                                                <p class="text-xs font-bold text-white truncate">@uploadedFileName</p>
                                                <p class="text-[10px] text-slate-400">@uploadedFileSizeFormatted</p>
                                            </div>
                                        </div>
                                        <button type="button" @onclick="RemoveUploadedFile" @onclick:stopPropagation="true" class="text-slate-400 hover:text-red-400 p-1 text-xs font-bold cursor-pointer transition-colors z-30 relative">
                                            ✕ Remove
                                        </button>
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(uploadError))
                            {
                                <p class="text-xs text-red-400 font-semibold mt-1">⚠️ @uploadError</p>
                            }
                        </div>

                        <!-- Province & City (FIXED: @bind instead of value=+@onchange) -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Province (ProvinceId: Guid) *</label>
                                <select @bind="registrationModel.ProvinceId" @bind:after="OnProvinceChanged" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                                    <option value="@Guid.Empty">-- Select Province --</option>
                                    @foreach (var prov in availableProvinces)
                                    {
                                        <option value="@prov.Id">@prov.Name</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">City (CityId: Guid) *</label>
                                <select @bind="registrationModel.CityId" disabled="@(registrationModel.ProvinceId == Guid.Empty)" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                                    <option value="@Guid.Empty">@(registrationModel.ProvinceId == Guid.Empty ? "Select Province First..." : "-- Select City --")</option>
                                    @foreach (var city in FilteredCities)
                                    {
                                        <option value="@city.Id">@city.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Contact Phone (ContactPhone) *</label>
                                <input type="tel" @bind="registrationModel.ContactPhone" placeholder="051-8463000" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                            </div>
                            <div>
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Emergency Phone (EmergencyPhone) *</label>
                                <input type="tel" @bind="registrationModel.EmergencyPhone" placeholder="0300-9998877" class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all">
                            </div>
                        </div>

                        <div>
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Complete Address (Address) *</label>
                            <textarea rows="2" @bind="registrationModel.Address" placeholder="Sector H-8/4, Pitras Bukhari Road..." class="w-full mt-1.5 bg-surface2 border border-line text-sm text-white font-semibold rounded-xl p-3 outline-none focus:border-blood-500 focus:bg-surface3 transition-all"></textarea>
                        </div>

                        <div class="flex gap-4">
                            <button type="button" @onclick="GoToStep1" class="w-1/3 border border-line hover:bg-surface3 text-slate-300 font-bold text-sm py-4 rounded-xl transition-all cursor-pointer">&larr; Back</button>
                            <button type="button" @onclick="GoToStep3" class="w-2/3 bg-blood-600 hover:bg-blood-700 text-white font-extrabold text-sm py-4 rounded-xl shadow-lg shadow-blood-900/40 transition-all cursor-pointer flex items-center justify-center gap-2">
                                <span>Next: SaaS Plan & Review</span>
                                <span>&rarr;</span>
                            </button>
                        </div>
                    </div>
                }

                <!-- SECTION 3: Plan Selection & Final Review -->
                @if (currentStep == 3)
                {
                    <div class="space-y-6">
                        <div class="border-b border-line pb-3 flex justify-between items-center">
                            <div>
                                <h2 class="text-lg font-bold text-white">Step 3: SaaS Subscription Tier & Entity Summary</h2>
                                <p class="text-xs text-slate-400">Final step before saving <code class="text-blood-400">BloodCenter</code> & <code class="text-blood-400">User</code></p>
                            </div>
                            <span class="text-xs text-slate-400 font-medium">Step 3 of 3</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Free Trial Card -->
                            <div @onclick='() => SelectPlan("trial")' class="border-2 @(registrationModel.SelectedPlan == "trial" ? "border-blood-500 bg-surface2" : "border-line bg-surface2/50 hover:border-slate-500") p-5 rounded-2xl cursor-pointer relative block transition-all">
                                <input type="radio" name="plan" checked="@(registrationModel.SelectedPlan == "trial")" class="absolute top-4 right-4 accent-blood-500 pointer-events-none">
                                <span class="bg-blood-500 text-white text-[10px] font-black px-2 py-0.5 rounded-md uppercase">Standard Option</span>
                                <h3 class="font-extrabold text-white text-base mt-2">14-Day Free Trial</h3>
                                <p class="text-2xl font-black text-blood-400 mt-1">PKR 0 <span class="text-xs font-medium text-slate-400">/ 14 days</span></p>
                                <ul class="text-xs text-slate-300 space-y-2 mt-4 font-semibold">
                                    <li>✓ Live Inventory Tracking</li>
                                    <li>✓ Emergency Donor Alerts</li>
                                    <li>✓ Direct Portal Access</li>
                                </ul>
                            </div>

                            <!-- Pro Plan Card -->
                            <div @onclick='() => SelectPlan("pro")' class="border-2 @(registrationModel.SelectedPlan == "pro" ? "border-blood-500 bg-surface2" : "border-line bg-surface2/50 hover:border-slate-500") p-5 rounded-2xl cursor-pointer relative block transition-all">
                                <input type="radio" name="plan" checked="@(registrationModel.SelectedPlan == "pro")" class="absolute top-4 right-4 accent-blood-500 pointer-events-none">
                                <span class="bg-surface3 text-slate-300 text-[10px] font-black px-2 py-0.5 rounded-md uppercase">Pro Tier</span>
                                <h3 class="font-extrabold text-white text-base mt-2">Enterprise Network</h3>
                                <p class="text-2xl font-black text-white mt-1">PKR 15,000 <span class="text-xs font-medium text-slate-400">/ month</span></p>
                                <ul class="text-xs text-slate-300 space-y-2 mt-4 font-semibold">
                                    <li>✓ Multi-Branch Management</li>
                                    <li>✓ Automated SMS Broadcasts</li>
                                    <li>✓ Dedicated Support Line</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Review -->
                        <div class="bg-surface2 p-4 rounded-xl border border-line text-xs space-y-2">
                            <h4 class="font-bold text-slate-300 uppercase tracking-wider text-[11px] border-b border-line pb-1 mb-2">Entity Mapping Payload Summary</h4>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1">
                                <p class="text-slate-400">BloodCenter.Name: <span class="text-white font-semibold">@registrationModel.Name</span></p>
                                <p class="text-slate-400">BloodCenter.RegistrationNumber: <span class="text-white font-semibold">@registrationModel.RegistrationNumber</span></p>
                                <p class="text-slate-400">BloodCenter.ProvinceId: <span class="text-blood-400 font-mono font-semibold">@registrationModel.ProvinceId</span> (@GetProvinceName(registrationModel.ProvinceId))</p>
                                <p class="text-slate-400">BloodCenter.CityId: <span class="text-blood-400 font-mono font-semibold">@registrationModel.CityId</span> (@GetCityName(registrationModel.CityId))</p>
                                <p class="text-slate-400">BloodCenter.ContactPhone: <span class="text-white font-semibold">@registrationModel.ContactPhone</span></p>
                                <p class="text-slate-400">BloodCenter.EmergencyPhone: <span class="text-white font-semibold">@registrationModel.EmergencyPhone</span></p>
                                <p class="text-slate-400">User.FullName: <span class="text-white font-semibold">@registrationModel.FullName</span></p>
                                <p class="text-slate-400">User.Email: <span class="text-white font-semibold">@registrationModel.Email</span></p>
                                <p class="text-slate-400">User.PhoneNumber: <span class="text-white font-semibold">@registrationModel.PhoneNumber</span></p>
                                <p class="text-slate-400">BloodCenter.DocumentUrl: <span class="text-vital-400 font-semibold truncate block">@(registrationModel.DocumentUrl ?? uploadedFileName ?? "Attached")</span></p>
                            </div>
                        </div>

                        <div class="flex gap-4 pt-2">
                            <button type="button" @onclick="GoToStep2" class="w-1/3 border border-line hover:bg-surface3 text-slate-300 font-bold text-sm py-4 rounded-xl transition-all cursor-pointer" disabled="@isSubmitting">&larr; Back</button>

                            <button type="button" @onclick="HandleSubmit" disabled="@isSubmitting" class="w-2/3 bg-vital-500 hover:bg-vital-600 text-slate-950 font-extrabold text-sm py-4 rounded-xl shadow-lg shadow-vital-500/20 transition-all text-center flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50">
                                @if (isSubmitting)
                                {
                                    <svg class="animate-spin h-5 w-5 text-slate-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    <span>Registering Entities...</span>
                                }
                                else
                                {
                                    <span>🚀 Submit & Register Center</span>
                                }
                            </button>
                        </div>
                    </div>
                }
            </EditForm>
        }
    </div>
</main>

@code {
    private int currentStep = 1;
    private string? stepErrorMessage;
    private bool isSubmitting = false;
    private bool isSubmittedSuccess = false;

    private BloodCenterRegistrationFormModel registrationModel = new();

    // File Upload State
    private IBrowserFile? selectedFile;
    private string? uploadedFileName;
    private string? uploadedFileSizeFormatted;
    private string? uploadError;

    // Available lookups
    private List<ProvinceLookUp> availableProvinces = new();
    private List<CityLookUp> availableCities = new();

    // FIXED: computed property — no stale state, no manual filtering
    private IEnumerable<CityLookUp> FilteredCities =>
        registrationModel.ProvinceId == Guid.Empty
            ? Enumerable.Empty<CityLookUp>()
            : availableCities.Where(c => c.ProvinceId == registrationModel.ProvinceId);

    protected override void OnInitialized()
    {
        InitializeLookups();
    }

    private void GoToStep1()
    {
        stepErrorMessage = null;
        currentStep = 1;
    }

    private void GoToStep2()
    {
        stepErrorMessage = null;

        if (string.IsNullOrWhiteSpace(registrationModel.FullName))
        {
            stepErrorMessage = "Please enter the Admin Full Name (FullName).";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationModel.Email) || !registrationModel.Email.Contains("@"))
        {
            stepErrorMessage = "Please enter a valid Admin Email address (Email).";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationModel.PhoneNumber))
        {
            stepErrorMessage = "Please enter the Admin Phone Number (PhoneNumber).";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationModel.Password) || registrationModel.Password.Length < 6)
        {
            stepErrorMessage = "Password must be at least 6 characters long.";
            return;
        }
        if (registrationModel.Password != registrationModel.ConfirmPassword)
        {
            stepErrorMessage = "Passwords do not match. Please re-check.";
            return;
        }

        currentStep = 2;
    }

    private void GoToStep3()
    {
        stepErrorMessage = null;

        if (string.IsNullOrWhiteSpace(registrationModel.Name))
        {
            stepErrorMessage = "Please enter the Blood Center Name (Name).";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationModel.RegistrationNumber))
        {
            stepErrorMessage = "Please enter the Registration Number (RegistrationNumber).";
            return;
        }
        if (selectedFile == null && string.IsNullOrEmpty(registrationModel.DocumentUrl))
        {
            stepErrorMessage = "Please upload an accreditation document (DocumentUrl).";
            return;
        }
        if (registrationModel.ProvinceId == Guid.Empty)
        {
            stepErrorMessage = "Please select a Province (ProvinceId).";
            return;
        }
        if (registrationModel.CityId == Guid.Empty)
        {
            stepErrorMessage = "Please select a City (CityId).";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationModel.ContactPhone))
        {
            stepErrorMessage = "Please enter the Contact Phone (ContactPhone).";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationModel.EmergencyPhone))
        {
            stepErrorMessage = "Please enter the Emergency Phone (EmergencyPhone).";
            return;
        }
        if (string.IsNullOrWhiteSpace(registrationModel.Address))
        {
            stepErrorMessage = "Please enter the full Address.";
            return;
        }

        currentStep = 3;
    }

    private void SelectPlan(string planId)
    {
        registrationModel.SelectedPlan = planId;
    }

