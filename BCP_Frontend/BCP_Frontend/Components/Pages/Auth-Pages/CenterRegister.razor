    // FilteredCities is a computed property, so no manual filtering needed.
    private void OnProvinceChanged()
    {
        registrationModel.CityId = Guid.Empty;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        stepErrorMessage = null;
        var file = e.File;

        if (file != null)
        {
            const long maxFileSize = 5 * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                uploadError = "File size exceeds the 5MB limit.";
                return;
            }

            var allowedExtensions = new[] { ".pdf", ".png", ".jpg", ".jpeg" };
            var extension = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
            if (!allowedExtensions.Contains(extension))
            {
                uploadError = "Invalid file type. Please upload a PDF, PNG, or JPG file.";
                return;
            }

            selectedFile = file;
            uploadedFileName = file.Name;
            uploadedFileSizeFormatted = $"{Math.Round((double)file.Size / 1024 / 1024, 2)} MB";
            registrationModel.DocumentUrl = $"uploads/licenses/{file.Name}";
        }
    }

    private void RemoveUploadedFile()
    {
        selectedFile = null;
        uploadedFileName = null;
        uploadedFileSizeFormatted = null;
        uploadError = null;
        registrationModel.DocumentUrl = null;
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        stepErrorMessage = null;

        // TODO: replace with real API call — save User + BloodCenter + upload file
        await Task.Delay(1500);

        isSubmitting = false;
        isSubmittedSuccess = true;
    }

