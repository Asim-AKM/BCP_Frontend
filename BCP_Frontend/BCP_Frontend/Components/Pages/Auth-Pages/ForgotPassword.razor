@using BCP_Frontend.Components.Layout
@page "/auth/forgot-password"
@layout EmptyLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="min-h-screen w-full flex items-center justify-center p-3 sm:p-6 lg:p-8 bg-slate-950 selection:bg-blood-600 selection:text-white overflow-y-auto">

    <!-- Outer Frame Box -->
    <div class="w-full max-w-5xl bg-gradient-to-br from-slate-900 via-slate-950 to-blood-950/80 rounded-2xl sm:rounded-3xl border border-white/10 shadow-2xl overflow-hidden relative flex flex-col lg:flex-row my-auto">
        
        <!-- Background Ambient Glows -->
        <div class="absolute -top-24 -left-24 w-60 sm:w-80 h-60 sm:h-80 bg-blood-800/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-60 sm:w-80 h-60 sm:h-80 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- LEFT COLUMN: Brand Hero -->
        <div class="lg:w-1/2 p-6 sm:p-8 lg:p-10 flex flex-col justify-between relative z-10 border-b lg:border-b-0 lg:border-r border-white/5 space-y-6 lg:space-y-0">
            
            <!-- Top Left Decorative 3D Vector Graphic -->
            <div class="absolute -top-10 -left-10 opacity-80 pointer-events-none hidden sm:block">
                <svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M40 100C40 40 100 20 160 50C120 100 180 160 100 180C40 180 40 140 40 100Z" fill="url(#grad1)" opacity="0.8" />
                    <path d="M20 80C20 20 80 10 140 30C100 80 160 140 80 160C20 160 20 120 20 80Z" fill="url(#grad2)" opacity="0.5" />
                    <defs>
                        <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#be123c" />
                            <stop offset="100%" stop-color="#4a041f" />
                        </linearGradient>
                        <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#fb7185" />
                            <stop offset="100%" stop-color="#880e4f" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>

            <!-- Header Brand Logo -->
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-blood-800 to-blood-600 flex items-center justify-center text-white text-base sm:text-lg shadow-lg shadow-blood-800/40 border border-white/20">
                    🩸
                </div>
                <div>
                    <span class="text-base sm:text-lg font-extrabold tracking-tight text-white block leading-none">BloodConnect<span class="text-blood-500">.pk</span></span>
                    <span class="text-[8px] sm:text-[9px] font-bold text-slate-400 tracking-wider uppercase">Unified SaaS Network</span>
                </div>
            </div>

            <!-- Center Content Headline -->
            <div class="space-y-2.5 sm:space-y-3 max-w-md my-auto py-4 lg:py-0">
                <span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-blood-950/80 border border-blood-600/30 text-blood-400 text-[10px] sm:text-[11px] font-bold">
                    <span class="w-1.5 h-1.5 rounded-full bg-blood-500 animate-ping"></span>
                    Secure Account Recovery
                </span>
                <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white leading-tight">
                    Recover Access to Your Center Portal
                </h1>
                <p class="text-xs text-slate-400 font-medium leading-relaxed">
                    Follow our secure 3-step chain process to reset your credentials safely without losing live inventory synchronization.
                </p>
            </div>

            <!-- Footer Action Links -->
            <div class="flex flex-wrap items-center gap-2 pt-2">
                <NavLink href="auth/login" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] sm:text-xs font-bold text-slate-300 transition-all">
                    &larr; Back to Log In
                </NavLink>
            </div>
        </div>

        <!-- RIGHT COLUMN: Multi-Step Recovery Box -->
        <div class="lg:w-1/2 p-5 sm:p-8 lg:p-10 flex items-center justify-center relative z-10">
            <div class="w-full max-w-sm bg-white/[0.04] backdrop-blur-2xl border border-white/10 rounded-xl sm:rounded-2xl p-5 sm:p-6 shadow-2xl">
                
                <!-- Step Indicator Header -->
                <div class="mb-4 sm:mb-5">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-lg sm:text-xl font-black text-white tracking-tight">Password Recovery</h2>
                        <span class="text-[11px] sm:text-xs font-extrabold text-blood-400 bg-blood-950/80 px-2.5 py-0.5 rounded-full border border-blood-600/30">Step @currentStep of 3</span>
                    </div>
                    
                    <!-- Progress Bar -->
                    <div class="w-full bg-slate-950 h-1.5 rounded-full overflow-hidden border border-white/10">
                        <div class="bg-gradient-to-r from-blood-700 to-blood-500 h-full transition-all duration-300" style="width: @(currentStep * 33.33)%"></div>
                    </div>
                </div>

                <!-- STEP 1: Enter Email -->
                @if (currentStep == 1)
                {
                    <div class="space-y-3.5 sm:space-y-4">
                        <p class="text-[10px] sm:text-[11px] text-slate-400 font-medium">Enter your registered official email address to receive a verification code.</p>
                        
                        <div>
                            <label class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Official Email</label>
                            <div class="relative">
                                <input type="email" @value="emailInput" required placeholder="admin@shifahospital.org" class="w-full bg-slate-900/80 border border-white/10 text-xs font-semibold text-white rounded-xl py-2.5 px-3 pl-9 outline-none focus:border-blood-500 focus:ring-1 focus:ring-blood-500 transition-all placeholder:text-slate-600">
                                <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" /></svg>
                            </div>
                        </div>

                        <button type="button" @onclick="NextStep" class="w-full bg-gradient-to-r from-blood-700 to-blood-600 hover:from-blood-600 hover:to-blood-500 text-white font-extrabold text-xs py-2.5 sm:py-3 rounded-xl shadow-lg shadow-blood-900/50 transition-all hover:scale-[1.01] active:scale-[0.99] mt-1 cursor-pointer">
                            Send Verification Code &rarr;
                        </button>
                    </div>
                }

                <!-- STEP 2: Enter OTP Code -->
                @if (currentStep == 2)
                {
                    <div class="space-y-3.5 sm:space-y-4">
                        <p class="text-[10px] sm:text-[11px] text-slate-400 font-medium">We have sent a 6-digit verification code to <span class="text-white font-bold">@emailInput</span>.</p>
                        
                        <div>
                            <label class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Enter 6-Digit Code</label>
                            <div class="relative">
                                <input type="text" maxlength="6" @value="otpInput" required placeholder="123456" class="w-full bg-slate-900/80 border border-white/10 text-sm tracking-widest font-bold text-center text-white rounded-xl py-2.5 px-3 outline-none focus:border-blood-500 focus:ring-1 focus:ring-blood-500 transition-all placeholder:text-slate-600">
                            </div>
                        </div>

                        <div class="flex gap-2 pt-1">
                            <button type="button" @onclick="PrevStep" class="w-1/3 border border-white/15 bg-white/5 hover:bg-white/10 text-slate-300 font-bold text-xs py-2.5 sm:py-3 rounded-xl transition-all cursor-pointer">&larr; Back</button>
                            <button type="button" @onclick="NextStep" class="w-2/3 bg-gradient-to-r from-blood-700 to-blood-600 hover:from-blood-600 hover:to-blood-500 text-white font-extrabold text-xs py-2.5 sm:py-3 rounded-xl shadow-lg shadow-blood-900/50 transition-all cursor-pointer">Verify Code &rarr;</button>
                        </div>

                        <div class="text-center pt-1">
                            <button type="button" class="text-[10px] sm:text-[11px] font-bold text-blood-400 hover:underline cursor-pointer">Didn't receive code? Resend</button>
                        </div>
                    </div>
                }

                <!-- STEP 3: Reset New Password -->
                @if (currentStep == 3)
                {
                    <div class="space-y-3.5 sm:space-y-4">
                        <p class="text-[10px] sm:text-[11px] text-slate-400 font-medium">Create a strong new password for your account.</p>
                        
                        <div>
                            <label class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">New Password</label>
                            <div class="relative">
                                <input type="password" @value="newPasswordInput" required placeholder="••••••••••••" class="w-full bg-slate-900/80 border border-white/10 text-xs font-semibold text-white rounded-xl py-2.5 px-3 pl-9 outline-none focus:border-blood-500 focus:ring-1 focus:ring-blood-500 transition-all placeholder:text-slate-600">
                                <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                            </div>
                        </div>

                        <div>
                            <label class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">Confirm Password</label>
                            <div class="relative">
                                <input type="password" @value="confirmPasswordInput" required placeholder="••••••••••••" class="w-full bg-slate-900/80 border border-white/10 text-xs font-semibold text-white rounded-xl py-2.5 px-3 pl-9 outline-none focus:border-blood-500 focus:ring-1 focus:ring-blood-500 transition-all placeholder:text-slate-600">
                                <svg class="w-4 h-4 text-slate-500 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                            </div>
                        </div>

                        <button type="button" @onclick="CompleteReset" class="w-full bg-gradient-to-r from-blood-700 to-blood-600 hover:from-blood-600 hover:to-blood-500 text-white font-extrabold text-xs py-2.5 sm:py-3 rounded-xl shadow-lg shadow-blood-900/50 transition-all hover:scale-[1.01] active:scale-[0.99] mt-1 cursor-pointer">
                            Update Password & Log In
                        </button>
                    </div>
                }

                <!-- Footer Return Prompt -->
                <div class="mt-4 sm:mt-5 pt-3.5 sm:pt-4 border-t border-white/10 text-center">
                    <p class="text-[10px] sm:text-[11px] text-slate-400 font-medium">Remembered your password?</p>
                    <NavLink href="auth/login" class="inline-block mt-1.5 w-full py-2 rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 text-xs font-extrabold text-white transition-all text-center">
                        Back to Log In
                    </NavLink>
                </div>

            </div>
        </div>

    </div>
</div>

@code {
    private int currentStep = 1;
    private string emailInput = "";
    private string otpInput = "";
    private string newPasswordInput = "";
    private string confirmPasswordInput = "";

    private void NextStep()
    {
        if (currentStep < 3) currentStep++;
    }

    private void PrevStep()
    {
        if (currentStep > 1) currentStep--;
    }

    private void CompleteReset()
    {
        Navigation.NavigateTo("auth/login");
    }
}