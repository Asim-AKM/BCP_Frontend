@page "/search-stock"
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<main class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <!-- Filter Section -->
    <div class="reveal glass rounded-2xl p-6 sm:p-8 mb-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-6 gap-2">
            <div>
                <h1 class="font-display text-2xl font-bold text-white">Live Inventory Directory</h1>
                <p class="text-xs text-slate-400 font-medium">Search verified real-time blood stock across partner centers in Pakistan</p>
            </div>
            <span class="text-xs font-semibold text-vital-400 bg-vital-500/10 px-3 py-1 rounded-md border border-vital-500/25 flex items-center gap-1.5">
                <span class="pulse-dot" style="background:#12d6ac"></span>Live Sync Active
            </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
            <!-- PROVINCE / REGION DROPDOWN -->
            <div>
                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Province / Region</label>
                <select Value="@selectedProvince" @onchange="OnProvinceChanged" class="w-full mt-1.5 bg-ink border border-line text-sm font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500 transition-all">
                    <option value="">All Provinces</option>
                    @foreach (var province in ProvinceCitiesMap.Keys)
                    {
                        <option value="@province">@province</option>
                    }
                </select>
            </div>

            <!-- CITY DROPDOWN (DYNAMICALLY FILTERED) -->
            <div>
                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">City</label>
                <select @bind="selectedCity" disabled="@(string.IsNullOrEmpty(selectedProvince))" class="w-full mt-1.5 bg-ink border border-line text-sm font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                    <option value="">All Cities</option>
                    @foreach (var city in availableCities)
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </div>

            <!-- BLOOD GROUP DROPDOWN -->
            <div>
                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Blood Group</label>
                <select @bind="selectedBloodGroup" class="w-full mt-1.5 bg-ink border border-line text-sm font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500 transition-all">
                    <option value="">All Blood Groups</option>
                    <option value="A+">A Positive (A+)</option>
                    <option value="A-">A Negative (A-)</option>
                    <option value="B+">B Positive (B+)</option>
                    <option value="B-">B Negative (B-)</option>
                    <option value="O+">O Positive (O+)</option>
                    <option value="O-">O Negative (O-)</option>
                    <option value="AB+">AB Positive (AB+)</option>
                    <option value="AB-">AB Negative (AB-)</option>
                </select>
            </div>

            <!-- COMPONENT DROPDOWN -->
            <div>
                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Component</label>
                <select @bind="selectedComponent" class="w-full mt-1.5 bg-ink border border-line text-sm font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500 transition-all">
                    <option value="">All Components</option>
                    <option value="Whole Blood">Whole Blood</option>
                    <option value="Platelets">Platelets</option>
                    <option value="Plasma">Plasma</option>
                    <option value="Packed RBCs">Packed RBCs</option>
                </select>
            </div>

            <!-- SUBMIT BUTTON -->
            <div class="flex items-end">
                <button @onclick="ApplyFilter" class="w-full bg-gradient-to-r from-blood-600 to-blood-700 hover:from-blood-500 hover:to-blood-600 text-white font-extrabold text-sm py-3.5 rounded-xl shadow-lg shadow-blood-950/40 transition-all">
                    Apply Filter
                </button>
            </div>
        </div>
    </div>

    <!-- Inventory Results List -->
    <div class="space-y-4">
        <!-- Item 1 -->
        <div class="reveal tilt-card bg-surface p-6 rounded-2xl border border-line flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:border-vital-500/40 transition-colors">
            <div>
                <div class="flex items-center gap-2">
                    <span class="bg-vital-500/10 text-vital-400 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase border border-vital-500/25">Verified Stock</span>
                    <span class="text-xs text-slate-500 font-medium">Updated 5 mins ago</span>
                </div>
                <h3 class="text-lg font-bold text-white mt-1">Shifa International Blood Bank</h3>
                <p class="text-xs text-slate-400">Pitras Bukhari Rd, H-8/4, Islamabad • Ph: (051) 8463000</p>
            </div>
            <div class="flex items-center gap-6 w-full md:w-auto justify-between md:justify-end">
                <div class="text-left md:text-center">
                    <span class="block text-2xl font-black text-blood-400">4 Units</span>
                    <span class="text-[10px] font-bold uppercase text-slate-500">O- Available</span>
                </div>
                <button @onclick='() => ReserveUnit("Shifa International Blood Bank", "O-", "Whole Blood")' class="bg-surface3 hover:bg-line text-white font-bold text-xs px-5 py-3 rounded-xl shadow-md border border-line transition-all hover:border-blood-500/50">
                    Reserve Unit
                </button>
            </div>
        </div>

        <!-- Item 2 -->
        <div class="reveal tilt-card bg-surface p-6 rounded-2xl border border-line flex flex-col md:flex-row items-start md:items-center justify-between gap-4 hover:border-signal-500/40 transition-colors" style="transition-delay:.06s">
            <div>
                <div class="flex items-center gap-2">
                    <span class="bg-signal-500/10 text-signal-400 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase border border-signal-500/25">Low Stock</span>
                    <span class="text-xs text-slate-500 font-medium">Updated 12 mins ago</span>
                </div>
                <h3 class="text-lg font-bold text-white mt-1">PIMS Central Blood Bank</h3>
                <p class="text-xs text-slate-400">G-8/3, Islamabad • Ph: (051) 9261170</p>
            </div>
            <div class="flex items-center gap-6 w-full md:w-auto justify-between md:justify-end">
                <div class="text-left md:text-center">
                    <span class="block text-2xl font-black text-signal-400">1 Unit</span>
                    <span class="text-[10px] font-bold uppercase text-slate-500">O- Available</span>
                </div>
                <button @onclick='() => ReserveUnit("PIMS Central Blood Bank", "O-", "Whole Blood")' class="bg-surface3 hover:bg-line text-white font-bold text-xs px-5 py-3 rounded-xl shadow-md border border-line transition-all hover:border-blood-500/50">
                    Reserve Unit
                </button>
            </div>
        </div>
    </div>
</main>

<!-- RESERVATION MODAL -->
@if (isReservationModalOpen)
{
    <div class="fixed inset-0 bg-ink/80 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface border border-line rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-5">
            <div class="flex items-center justify-between border-b border-line pb-3">
                <div>
                    <span class="text-[10px] font-bold uppercase text-blood-400">Instant Stock Reservation</span>
                    <h3 class="font-bold text-white text-base">@selectedBankName</h3>
                </div>
                <button @onclick="CloseModal" class="text-slate-400 hover:text-white font-bold text-lg">&times;</button>
            </div>

            @if (reservationSuccess)
            {
                <div class="p-4 bg-vital-500/10 border border-vital-500/25 rounded-xl space-y-3 text-center">
                    <span class="text-3xl">🎉</span>
                    <h4 class="text-sm font-bold text-vital-400">Reservation Confirmed!</h4>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        Your reservation ID is <strong class="text-white font-mono">#RES-@reservationId</strong>.
                        The unit has been placed on temporary hold for <strong>2 hours</strong>. Please present this token at the center desk.
                    </p>
                    <button @onclick="CloseModal" class="w-full bg-surface2 hover:bg-surface3 text-white font-bold text-xs py-2.5 rounded-xl border border-line mt-2">
                        Close
                    </button>
                </div>
            }
            else
            {
                <EditForm Model="reservationModel" OnValidSubmit="ConfirmReservation" class="space-y-4 text-xs">
                    <div class="bg-ink p-3 rounded-xl border border-line flex justify-between items-center font-semibold">
                        <span class="text-slate-400">Reserved Group & Component:</span>
                        <span class="text-blood-400 font-bold">@selectedGroup (@selectedComp)</span>
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase text-slate-400">Patient Name</label>
                        <InputText @bind-Value="reservationModel.PatientName" required class="w-full mt-1.5 bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500" placeholder="Enter patient full name" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs font-bold uppercase text-slate-400">Attendant Phone</label>
                            <InputText @bind-Value="reservationModel.ContactPhone" required class="w-full mt-1.5 bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500" placeholder="03xx-xxxxxxx" />
                        </div>
                        <div>
                            <label class="text-xs font-bold uppercase text-slate-400">Hospital / Ward</label>
                            <InputText @bind-Value="reservationModel.HospitalWard" required class="w-full mt-1.5 bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500" placeholder="e.g. PIMS Ward 3" />
                        </div>
                    </div>

                    <p class="text-[11px] text-slate-500">
                        ⚠️ <em>Note: Reserved units are held for a maximum of 120 minutes before returning to available stock.</em>
                    </p>

                    <div class="flex items-center gap-3 pt-2">
                        <button type="button" @onclick="CloseModal" class="w-1/2 bg-surface2 hover:bg-surface3 text-slate-300 font-bold py-3 rounded-xl border border-line">
                            Cancel
                        </button>
                        <button type="submit" class="w-1/2 bg-gradient-to-r from-blood-600 to-blood-700 hover:from-blood-500 hover:to-blood-600 text-white font-extrabold py-3 rounded-xl shadow-lg shadow-blood-950/40">
                            Confirm Hold
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}

@code {
    private string selectedProvince = "";
    private string selectedCity = "";
    private string selectedBloodGroup = "";
    private string selectedComponent = "";

    private List<string> availableCities = new();

    private bool isReservationModalOpen = false;
    private bool reservationSuccess = false;
    private string selectedBankName = "";
    private string selectedGroup = "";
    private string selectedComp = "";
    private string reservationId = "";

    private ReservationRequest reservationModel = new();

    private readonly Dictionary<string, List<string>> ProvinceCitiesMap = new()
    {
        { "Federal Capital", new List<string> { "Islamabad" } },
        { "Punjab", new List<string> { "Lahore", "Rawalpindi", "Faisalabad", "Multan", "Gujranwala", "Sialkot", "Bahawalpur", "Sargodha" } },
        { "Sindh", new List<string> { "Karachi", "Hyderabad", "Sukkur", "Larkana", "Nawabshah" } },
        { "Khyber Pakhtunkhwa", new List<string> { "Peshawar", "Mardan", "Abbottabad", "Swat", "Dera Ismail Khan", "Kohat" } },
        { "Balochistan", new List<string> { "Quetta", "Gwadar", "Turbat", "Khuzdar" } },
        { "Gilgit-Baltistan", new List<string> { "Gilgit", "Skardu" } },
        { "Azad Kashmir", new List<string> { "Muzaffarabad", "Mirpur" } }
    };

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (queryParams.TryGetValue("province", out var provValue))
        {
            var prov = provValue.ToString();
            if (ProvinceCitiesMap.ContainsKey(prov))
            {
                selectedProvince = prov;
                availableCities = ProvinceCitiesMap[prov];
            }
        }

        if (queryParams.TryGetValue("city", out var cityValue))
        {
            var city = cityValue.ToString();
            var matchedCity = availableCities.FirstOrDefault(c => c.Equals(city, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(matchedCity))
            {
                selectedCity = matchedCity;
            }
        }

        if (queryParams.TryGetValue("group", out var groupValue))
        {
            selectedBloodGroup = groupValue.ToString();
        }

        if (queryParams.TryGetValue("component", out var compValue))
        {
            selectedComponent = compValue.ToString();
        }
    }

    private void OnProvinceChanged(ChangeEventArgs e)
    {
        selectedProvince = e.Value?.ToString() ?? "";
        selectedCity = "";

        if (!string.IsNullOrEmpty(selectedProvince) && ProvinceCitiesMap.ContainsKey(selectedProvince))
        {
            availableCities = ProvinceCitiesMap[selectedProvince];
        }
        else
        {
            availableCities.Clear();
        }
    }

    private void ApplyFilter()
    {
        // Filter action / Backend query trigger
    }

    private void ReserveUnit(string bankName, string group, string component)
    {
        selectedBankName = bankName;
        selectedGroup = string.IsNullOrEmpty(group) ? "O-" : group;
        selectedComp = string.IsNullOrEmpty(component) ? "Whole Blood" : component;
        reservationSuccess = false;
        reservationModel = new ReservationRequest();
        isReservationModalOpen = true;
    }

    private void ConfirmReservation()
    {
        // Reservation confirm processing
        reservationId = Random.Shared.Next(10000, 99999).ToString();
        reservationSuccess = true;
    }

    private void CloseModal()
    {
        isReservationModalOpen = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initPublicPageScript");
        }
    }

    public class ReservationRequest
    {
        public string PatientName { get; set; } = string.Empty;
        public string ContactPhone { get; set; } = string.Empty;
        public string HospitalWard { get; set; } = string.Empty;
    }
}