@page "/center/dashboard"
@layout CenterLayout
@rendermode InteractiveServer

<!-- Header Banner -->
<div class="bg-[#090d1a] rounded-2xl p-6 border border-[#182032] flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div>
        <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-widest">SHIFA INTERNATIONAL BLOOD BANK (ISB-MAIN-01)</span>
        <h1 class="text-2xl font-black text-white mt-1 tracking-tight">Inventory & Dispatch Command Center</h1>
    </div>
    <button @onclick="OpenUpdateModal" class="w-full md:w-auto bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs px-5 py-3 rounded-xl shadow-lg shadow-red-950/50 transition-all flex items-center justify-center gap-2 cursor-pointer">
        <span>+</span> Quick Stock Update
    </button>
</div>

<!-- Key Stat Cards -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-[#090d1a] p-5 rounded-2xl border border-[#182032] space-y-2">
        <div class="flex items-center justify-between text-slate-400">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">TOTAL UNITS IN STOCK</span>
            <span class="text-base">🩸</span>
        </div>
        <p class="text-3xl font-black text-white">@Statistics?.TotalUnitsInStock</p>
        <p class="text-xs text-emerald-400 font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Across 8 blood groups
        </p>
    </div>

    <div class="bg-[#090d1a] p-5 rounded-2xl border border-[#182032] space-y-2">
        <div class="flex items-center justify-between text-slate-400">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">TODAY'S DISPATCHES</span>
            <span class="text-base">📋</span>
        </div>
        <p class="text-3xl font-black text-white">@Statistics?.TodaysDispatches</p>
        <p class="text-xs text-slate-500 font-semibold">3 emergency, 6 routine</p>
    </div>

    <div class="bg-[#090d1a] p-5 rounded-2xl border border-[#182032] space-y-2">
        <div class="flex items-center justify-between text-slate-400">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">PENDING REQUESTS</span>
            <span class="text-base">🚨</span>
        </div>
        <p class="text-3xl font-black text-red-500">@Statistics?.PendingRequests</p>
        <p class="text-xs text-red-400 font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span> 1 immediate priority
        </p>
    </div>

    <div class="bg-[#090d1a] p-5 rounded-2xl border border-[#182032] space-y-2">
        <div class="flex items-center justify-between text-slate-400">
            <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">REGISTERED DONORS</span>
            <span class="text-base">👥</span>
        </div>
        <p class="text-3xl font-black text-white">@Statistics?.RegisteredDonors</p>
        <p class="text-xs text-emerald-400 font-bold">28 available this week</p>
    </div>
</div>

<!-- Stock Grid Matrix -->
<div>
    <h2 class="text-[11px] font-black uppercase tracking-widest text-slate-500 mb-3">LIVE STOCK UNITS MATRIX</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
        @foreach (var item in StockMatrix)
        {
            <div class="bg-[#090d1a] p-4 rounded-xl border border-[#182032] text-center">

                <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-md @GetStockStatusClass(item.StockStatus)">
                    @item.BloodGroup
                </span>

                <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-md @GetStockStatusClass(item.StockStatus)">

                    @item.TotalUnits
                </span>

                <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-md @GetStockStatusClass(item.StockStatus)">

                    @item.StockStatus
                </span>
            </div>
        }
    </div>
</div>

<!-- Incoming Requests Table -->
<div class="bg-[#090d1a] rounded-2xl border border-[#182032] p-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 mb-4">
        <div>
            <h3 class="font-extrabold text-white text-base">Incoming Emergency Requests</h3>
            <p class="text-xs text-slate-400 font-medium">Broadcasts active in your city requiring unit reservation</p>
        </div>
        <span class="bg-red-500/10 text-red-400 text-xs font-black px-2.5 py-1 rounded-md border border-red-500/20">2 Pending Alerts</span>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-semibold border-collapse min-w-[600px]">
            <thead>
                <tr class="border-b border-[#182032] text-slate-500 font-extrabold uppercase tracking-wider">
                    <th class="py-3 px-2">Patient Name</th>
                    <th class="py-3 px-2">Group</th>
                    <th class="py-3 px-2">Units</th>
                    <th class="py-3 px-2">Hospital</th>
                    <th class="py-3 px-2">Urgency</th>
                    <th class="py-3 px-2 text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-[#182032] text-slate-300">
                <tr>
                    <td class="py-4 px-2 font-bold text-white">Zainab Bibi</td>
                    <td class="py-4 px-2 text-red-500 font-black">O-</td>
                    <td class="py-4 px-2">2 Units</td>
                    <td class="py-4 px-2">PIMS Hospital, ICU Ward 3</td>
                    <td class="py-4 px-2"><span class="bg-red-500/10 text-red-400 text-[10px] font-black px-2 py-0.5 rounded-md uppercase border border-red-500/20">Immediate</span></td>
                    <td class="py-4 px-2 text-right"><button class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold px-3.5 py-2 rounded-xl transition-colors cursor-pointer">Accept & Dispatch</button></td>
                </tr>
                <tr>
                    <td class="py-4 px-2 font-bold text-white">Muhammad Ali</td>
                    <td class="py-4 px-2 text-red-500 font-black">A-</td>
                    <td class="py-4 px-2">1 Unit</td>
                    <td class="py-4 px-2">Ali Medical Centre, G-8</td>
                    <td class="py-4 px-2"><span class="bg-amber-500/10 text-amber-400 text-[10px] font-black px-2 py-0.5 rounded-md uppercase border border-amber-500/20">Within 12 Hrs</span></td>
                    <td class="py-4 px-2 text-right"><button class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold px-3.5 py-2 rounded-xl transition-colors cursor-pointer">Accept & Dispatch</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
@if (isUpdateModalOpen)
{
    <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-[#090d1a] border border-[#182032] rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
            <div class="flex items-center justify-between border-b border-[#182032] pb-3 mb-4">
                <h3 class="font-extrabold text-white text-base">Quick Stock Entry</h3>
                <button @onclick="CloseUpdateModal" class="text-slate-400 hover:text-white font-bold text-lg cursor-pointer">&times;</button>
            </div>
            <form class="space-y-4" @onsubmit="HandleStockUpdate">
                <div>
                    <label class="text-[10px] font-black uppercase tracking-wider text-slate-400 mb-1 block">Blood Group</label>
                    <select @bind="selectedGroup" class="w-full bg-[#050811] border border-[#182032] text-xs font-bold text-slate-100 rounded-xl p-3 outline-none focus:border-red-500">
                        <option value="O-">O Negative (O-)</option>
                        <option value="A+">A Positive (A+)</option>
                        <option value="B+">B Positive (B+)</option>
                    </select>
                </div>
                <div>
                    <label class="text-[10px] font-black uppercase tracking-wider text-slate-400 mb-1 block">Component</label>
                    <select @bind="selectedComponent" class="w-full bg-[#050811] border border-[#182032] text-xs font-bold text-slate-100 rounded-xl p-3 outline-none focus:border-red-500">
                        <option value="Whole Blood">Whole Blood</option>
                        <option value="Platelets">Platelets</option>
                        <option value="Plasma">Plasma</option>
                    </select>
                </div>
                <div>
                    <label class="text-[10px] font-black uppercase tracking-wider text-slate-400 mb-1 block">Available Units</label>
                    <input type="number" @bind="unitsInput" min="1" class="w-full bg-[#050811] border border-[#182032] text-xs font-bold text-slate-100 rounded-xl p-3 outline-none focus:border-red-500">
                </div>
                <button type="submit" class="w-full bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs py-3.5 rounded-xl shadow-lg shadow-red-950/50 transition-all cursor-pointer">
                    Sync Live Inventory
                </button>
            </form>
        </div>
    </div>
}

@code {
    private bool isUpdateModalOpen = false;
    private string selectedGroup = "O-";
    private string selectedComponent = "Whole Blood";
    private int unitsInput = 5;

    private void OpenUpdateModal() => isUpdateModalOpen = true;
    private void CloseUpdateModal() => isUpdateModalOpen = false;
    private void HandleStockUpdate() => CloseUpdateModal();
}