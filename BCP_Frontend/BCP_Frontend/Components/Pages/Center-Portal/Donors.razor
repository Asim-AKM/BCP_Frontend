@page "/center/donors"
@layout CenterLayout

<!-- Header Action Banner -->
<div class="bg-surface rounded-2xl p-4 sm:p-6 border border-line flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div>
        <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Volunteers & Records</span>
        <h1 class="font-display text-xl sm:text-2xl font-bold text-white mt-0.5">Donor Registry & Collection Log</h1>
    </div>
    <button @onclick="OpenRegisterModal" class="w-full md:w-auto bg-gradient-to-r from-blood-600 to-blood-700 hover:from-blood-500 hover:to-blood-600 text-white font-extrabold text-xs px-5 py-3 rounded-xl shadow-lg shadow-blood-950/40 transition-all flex items-center justify-center gap-2">
        <span>+</span> Register New Donor
    </button>
</div>

<!-- Summary Metrics Grid -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-surface p-4 rounded-2xl border border-line">
        <p class="text-xs font-bold text-slate-500 uppercase">Registered Donors</p>
        <p class="font-display text-2xl font-bold text-white mt-1">@donors.Count</p>
    </div>
    <div class="bg-surface p-4 rounded-2xl border border-line">
        <p class="text-xs font-bold text-slate-500 uppercase">Eligible to Donate Today</p>
        <p class="font-display text-2xl font-bold text-vital-400 mt-1">@donors.Count(d => d.IsEligible)</p>
    </div>
    <div class="bg-surface p-4 rounded-2xl border border-line">
        <p class="text-xs font-bold text-slate-500 uppercase">Donations This Month</p>
        <p class="font-display text-2xl font-bold text-blood-400 mt-1">168 Units</p>
    </div>
</div>

<!-- Filter & Search Controls -->
<div class="bg-surface rounded-2xl border border-line p-4 flex flex-col sm:flex-row gap-3 items-center justify-between">
    <div class="w-full sm:w-72">
        <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search by name, CNIC, mobile..."
               class="w-full bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl px-3.5 py-2.5 outline-none focus:border-blood-500 transition-colors" />
    </div>
    <div class="flex gap-2 w-full sm:w-auto">
        <select @bind="selectedBloodGroup" class="bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl px-3 py-2.5 outline-none focus:border-blood-500 flex-1 sm:flex-none">
            <option value="">All Blood Groups</option>
            <option value="A+">A+</option>
            <option value="O+">O+</option>
            <option value="O-">O-</option>
            <option value="B+">B+</option>
            <option value="AB+">AB+</option>
            <option value="AB-">AB-</option>
        </select>
        <select @bind="selectedEligibility" class="bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl px-3 py-2.5 outline-none focus:border-blood-500 flex-1 sm:flex-none">
            <option value="">Eligibility Status</option>
            <option value="Eligible">Eligible Now</option>
            <option value="Wait">Deferred / Temporary</option>
        </select>
    </div>
</div>

<!-- Registry Data Table -->
<div class="bg-surface rounded-2xl border border-line p-4 sm:p-6">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-medium border-collapse min-w-[700px]">
            <thead>
                <tr class="border-b border-line text-slate-500 font-bold uppercase tracking-wider">
                    <th class="py-3 px-2">Donor Name & CNIC</th>
                    <th class="py-3 px-2">Blood Group</th>
                    <th class="py-3 px-2">Contact Info</th>
                    <th class="py-3 px-2">Last Donation</th>
                    <th class="py-3 px-2">Eligibility Status</th>
                    <th class="py-3 px-2 text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line text-slate-300 font-semibold">
                @foreach (var donor in FilteredDonors)
                {
                    <tr>
                        <td class="py-4 px-2">
                            <p class="font-bold text-white">@donor.Name</p>
                            <p class="text-[10px] text-slate-500 font-mono-data">@donor.CNIC</p>
                        </td>
                        <td class="py-4 px-2">
                            <span class="font-black text-blood-400 bg-blood-500/10 px-2 py-0.5 rounded border border-blood-500/25">@donor.BloodGroup</span>
                        </td>
                        <td class="py-4 px-2">
                            <p class="text-white">@donor.Phone</p>
                            <p class="text-[10px] text-slate-500">@donor.City</p>
                        </td>
                        <td class="py-4 px-2 text-slate-500">@donor.LastDonationDate.ToString("dd MMM yyyy")</td>
                        <td class="py-4 px-2">
                            @if (donor.IsEligible)
                            {
                                <span class="bg-vital-500/10 text-vital-400 text-[10px] font-black px-2 py-0.5 rounded-md border border-vital-500/25 uppercase">Eligible</span>
                            }
                            else
                            {
                                <span class="bg-signal-500/10 text-signal-400 text-[10px] font-black px-2 py-0.5 rounded-md border border-signal-500/25 uppercase">Wait (@donor.WaitDaysRemaining Days)</span>
                            }
                        </td>
                        <td class="py-4 px-2 text-right">
                            @if (donor.IsEligible)
                            {
                                <button @onclick="() => LogDonation(donor)" class="bg-gradient-to-r from-blood-600 to-blood-700 hover:from-blood-500 hover:to-blood-600 text-white font-bold px-3 py-1.5 rounded-lg text-[11px] transition-colors">
                                    Log Donation
                                </button>
                            }
                            else
                            {
                                <button disabled class="bg-surface3 text-slate-500 cursor-not-allowed font-bold px-3 py-1.5 rounded-lg text-[11px] border border-line">
                                    Log Donation
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Register Donor -->
@if (isModalOpen)
{
    <div class="fixed inset-0 bg-ink/80 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface border border-line rounded-2xl max-w-lg w-full p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-line pb-3 mb-4">
                <h3 class="font-bold text-white text-base">Register Volunteer Donor</h3>
                <button @onclick="CloseRegisterModal" class="text-slate-400 hover:text-white font-bold text-lg">&times;</button>
            </div>
            <EditForm Model="newDonor" OnValidSubmit="HandleRegisterDonor" class="space-y-4">
                <DataAnnotationsValidator />
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold uppercase text-slate-400">Full Name</label>
                        <InputText @bind-Value="newDonor.Name" required placeholder="Kamran Akmal" class="w-full mt-1 bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500" />
                    </div>
                    <div>
                        <label class="text-xs font-bold uppercase text-slate-400">CNIC / ID Number</label>
                        <InputText @bind-Value="newDonor.CNIC" required placeholder="37405-0000000-0" class="w-full mt-1 bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500" />
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold uppercase text-slate-400">Blood Group</label>
                        <InputSelect @bind-Value="newDonor.BloodGroup" class="w-full mt-1 bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500">
                            <option value="O+">O Positive (O+)</option>
                            <option value="O-">O Negative (O-)</option>
                            <option value="A+">A Positive (A+)</option>
                            <option value="A-">A Negative (A-)</option>
                            <option value="B+">B Positive (B+)</option>
                            <option value="B-">B Negative (B-)</option>
                            <option value="AB+">AB Positive (AB+)</option>
                            <option value="AB-">AB Negative (AB-)</option>
                        </InputSelect>
                    </div>
                    <div>
                        <label class="text-xs font-bold uppercase text-slate-400">Mobile Phone</label>
                        <InputText @bind-Value="newDonor.Phone" required placeholder="0300 0000000" class="w-full mt-1 bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500" />
                    </div>
                </div>
                <div>
                    <label class="text-xs font-bold uppercase text-slate-400">City / Region</label>
                    <InputText @bind-Value="newDonor.City" placeholder="Islamabad" class="w-full mt-1 bg-ink border border-line text-xs font-semibold text-slate-100 rounded-xl p-3 outline-none focus:border-blood-500" />
                </div>
                <button type="submit" class="w-full bg-gradient-to-r from-blood-600 to-blood-700 hover:from-blood-500 hover:to-blood-600 text-white font-extrabold text-xs py-3.5 rounded-xl shadow-lg shadow-blood-950/40 transition-all">
                    Register & Save Record
                </button>
            </EditForm>
        </div>
    </div>
}

@code {
    private bool isModalOpen = false;
    private string searchTerm = string.Empty;
    private string selectedBloodGroup = string.Empty;
    private string selectedEligibility = string.Empty;

    private DonorModel newDonor = new();

    private List<DonorModel> donors = new()
    {
        new DonorModel { Id = 1, Name = "Muhammad Hamza", CNIC = "37405-1234567-1", BloodGroup = "O+", Phone = "+92 300 1234567", City = "Islamabad", LastDonationDate = new DateTime(2026, 5, 10), IsEligible = true },
        new DonorModel { Id = 2, Name = "Ayesha Bilal", CNIC = "61101-9876543-2", BloodGroup = "AB-", Phone = "+92 333 7654321", City = "Rawalpindi", LastDonationDate = new DateTime(2026, 8, 1), IsEligible = false, WaitDaysRemaining = 78 },
        new DonorModel { Id = 3, Name = "Bilal Hassan", CNIC = "35201-4455667-3", BloodGroup = "B+", Phone = "+92 321 9876543", City = "Islamabad", LastDonationDate = new DateTime(2026, 1, 12), IsEligible = true }
    };

    private IEnumerable<DonorModel> FilteredDonors => donors.Where(d =>
        (string.IsNullOrWhiteSpace(searchTerm) || d.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || d.CNIC.Contains(searchTerm) || d.Phone.Contains(searchTerm)) &&
        (string.IsNullOrWhiteSpace(selectedBloodGroup) || d.BloodGroup == selectedBloodGroup) &&
        (string.IsNullOrWhiteSpace(selectedEligibility) || (selectedEligibility == "Eligible" ? d.IsEligible : !d.IsEligible))
    );

    private void OpenRegisterModal()
    {
        newDonor = new DonorModel { BloodGroup = "O+" };
        isModalOpen = true;
    }

    private void CloseRegisterModal() => isModalOpen = false;

    private void HandleRegisterDonor()
    {
        newDonor.Id = donors.Count + 1;
        newDonor.LastDonationDate = DateTime.Now;
        newDonor.IsEligible = true;
        donors.Add(newDonor);
        isModalOpen = false;
    }

    private void LogDonation(DonorModel donor)
    {
        donor.LastDonationDate = DateTime.Now;
        donor.IsEligible = false;
        donor.WaitDaysRemaining = 90;
    }

    public class DonorModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string CNIC { get; set; } = string.Empty;
        public string BloodGroup { get; set; } = "O+";
        public string Phone { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public DateTime LastDonationDate { get; set; }
        public bool IsEligible { get; set; }
        public int WaitDaysRemaining { get; set; }
    }
}