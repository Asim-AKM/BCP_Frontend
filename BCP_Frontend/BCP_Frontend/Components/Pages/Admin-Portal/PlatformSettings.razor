@using BCP_Frontend.Components.Layout
@page "/admin/platform-settings"
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>Platform Settings — BloodConnect.pk</PageTitle>

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="font-display text-2xl font-bold tracking-tight text-white">Platform Settings</h1>
        <p class="text-xs text-slate-400 mt-1">Global configuration for notifications, SaaS pricing tiers, security policy, and system maintenance.</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- General -->
    <div class="lg:col-span-2 bg-surface rounded-2xl border border-line p-5 sm:p-6 space-y-5">
        <h2 class="text-sm font-bold text-white uppercase tracking-wider border-b border-line pb-3">General Platform Information</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div>
                <label class="block text-slate-400 font-bold mb-1">Platform Name</label>
                <input type="text" value="BloodConnect.pk" class="w-full bg-ink border border-line rounded-xl p-3 text-slate-200 focus:outline-none focus:border-blood-500">
            </div>
            <div>
                <label class="block text-slate-400 font-bold mb-1">Support Contact Email</label>
                <input type="email" value="support@bloodconnect.pk" class="w-full bg-ink border border-line rounded-xl p-3 text-slate-200 focus:outline-none focus:border-blood-500">
            </div>
            <div>
                <label class="block text-slate-400 font-bold mb-1">Default Broadcast Radius (km)</label>
                <input type="number" value="15" class="w-full bg-ink border border-line rounded-xl p-3 text-slate-200 focus:outline-none focus:border-blood-500">
            </div>
            <div>
                <label class="block text-slate-400 font-bold mb-1">Emergency Escalation Timeout</label>
                <select class="w-full bg-ink border border-line rounded-xl p-3 text-slate-200 focus:outline-none focus:border-blood-500">
                    <option>15 Minutes</option>
                    <option selected>30 Minutes</option>
                    <option>60 Minutes</option>
                </select>
            </div>
        </div>
        <div class="flex items-center justify-between bg-ink p-3.5 rounded-xl border border-line">
            <div>
                <p class="text-xs font-bold text-white">Platform Maintenance Mode</p>
                <p class="text-[11px] text-slate-500">Temporarily disable public access for scheduled upgrades.</p>
            </div>
            <button @onclick="ToggleMaintenanceMode" class="@(isMaintenanceMode ? "bg-blood-600" : "bg-surface3") w-11 h-6 rounded-full relative transition-colors shrink-0 cursor-pointer">
                <span class="block w-[18px] h-[18px] bg-white rounded-full absolute top-[3px] @(isMaintenanceMode ? "translate-x-5" : "left-[3px]") transition-transform"></span>
            </button>
        </div>
        <div class="flex justify-end">
            <button @onclick="SaveGeneralSettings" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-blood-600 to-blood-700 hover:from-blood-500 hover:to-blood-600 text-white font-bold text-xs shadow-md cursor-pointer">Save General Settings</button>
        </div>
    </div>

    <!-- Security -->
    <div class="bg-surface rounded-2xl border border-line p-5 sm:p-6 space-y-5">
        <h2 class="text-sm font-bold text-white uppercase tracking-wider border-b border-line pb-3">Security Policy</h2>
        <div class="space-y-3 text-xs">
            <div class="flex items-center justify-between">
                <span class="text-slate-300 font-semibold">Enforce 2FA for Admins</span>
                <button @onclick="() => enforce2FA = !enforce2FA" class="@(enforce2FA ? "bg-vital-500" : "bg-surface3") w-10 h-[22px] rounded-full relative transition-colors shrink-0 cursor-pointer">
                    <span class="block w-[16px] h-[16px] bg-white rounded-full absolute top-[3px] @(enforce2FA ? "left-[21px]" : "left-[3px]") transition-transform"></span>
                </button>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-slate-300 font-semibold">Auto-lock Idle Sessions</span>
                <button @onclick="() => autoLockIdle = !autoLockIdle" class="@(autoLockIdle ? "bg-vital-500" : "bg-surface3") w-10 h-[22px] rounded-full relative transition-colors shrink-0 cursor-pointer">
                    <span class="block w-[16px] h-[16px] bg-white rounded-full absolute top-[3px] @(autoLockIdle ? "left-[21px]" : "left-[3px]") transition-transform"></span>
                </button>
            </div>
            <div>
                <label class="block text-slate-400 font-bold mb-1 mt-2">Session Timeout</label>
                <select class="w-full bg-ink border border-line rounded-xl p-2.5 text-slate-200 focus:outline-none focus:border-blood-500">
                    <option>15 Minutes</option>
                    <option selected>30 Minutes</option>
                    <option>1 Hour</option>
                </select>
            </div>
        </div>
        <div class="pt-2 border-t border-line">
            <p class="text-[11px] font-bold text-slate-400 uppercase mb-2">API Master Key</p>
            <div class="bg-ink p-2.5 rounded-lg border border-line flex items-center justify-between">
                <span class="font-mono text-[11px] text-slate-400">sk_live_••••••••••4f2c</span>
                <button @onclick="OpenRegenModal" class="text-[10px] font-bold text-blood-400 hover:text-blood-300 cursor-pointer">Regenerate</button>
            </div>
        </div>
    </div>
</div>

<!-- SaaS Pricing Tiers -->
<div class="bg-surface rounded-2xl border border-line p-5 sm:p-6 space-y-5">
    <div class="flex items-center justify-between border-b border-line pb-3">
        <h2 class="text-sm font-bold text-white uppercase tracking-wider">SaaS Subscription Tiers</h2>
        <span class="text-[11px] text-slate-500 font-medium">Changes apply to new subscriptions only</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-ink p-4 rounded-xl border border-line space-y-2">
            <p class="text-xs font-black text-slate-300 uppercase">Standard</p>
            <p class="font-display text-xl font-bold text-white">PKR 25,000<span class="text-xs text-slate-500 font-medium">/yr</span></p>
            <p class="text-[11px] text-slate-500">Up to 500 monthly inventory syncs</p>
            <button @onclick='() => OpenTierModal("Standard", "25000")' class="w-full bg-surface3 hover:bg-line text-slate-200 text-xs font-bold py-2 rounded-lg mt-2 cursor-pointer">Edit Tier</button>
        </div>
        <div class="bg-ink p-4 rounded-xl border border-ice-500/30 space-y-2 relative">
            <span class="absolute -top-2.5 right-3 bg-ice-500 text-slate-950 text-[9px] font-black px-2 py-0.5 rounded-full">POPULAR</span>
            <p class="text-xs font-black text-ice-400 uppercase">Professional</p>
            <p class="font-display text-xl font-bold text-white">PKR 45,000<span class="text-xs text-slate-500 font-medium">/yr</span></p>
            <p class="text-[11px] text-slate-500">Unlimited syncs + emergency priority</p>
            <button @onclick='() => OpenTierModal("Professional", "45000")' class="w-full bg-surface3 hover:bg-line text-slate-200 text-xs font-bold py-2 rounded-lg mt-2 cursor-pointer">Edit Tier</button>
        </div>
        <div class="bg-ink p-4 rounded-xl border border-line space-y-2">
            <p class="text-xs font-black text-slate-300 uppercase">Enterprise</p>
            <p class="font-display text-xl font-bold text-white">PKR 85,000<span class="text-xs text-slate-500 font-medium">/yr</span></p>
            <p class="text-[11px] text-slate-500">Multi-branch + dedicated API access</p>
            <button @onclick='() => OpenTierModal("Enterprise", "85000")' class="w-full bg-surface3 hover:bg-line text-slate-200 text-xs font-bold py-2 rounded-lg mt-2 cursor-pointer">Edit Tier</button>
        </div>
    </div>
</div>

<!-- EDIT TIER MODAL -->
@if (isTierModalOpen)
{
    <div class="fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-line w-full max-w-md rounded-2xl shadow-2xl overflow-hidden space-y-6 p-6 relative">
            <button @onclick="CloseModals" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <div class="border-b border-line pb-3">
                <h3 class="text-base font-bold text-white">Edit @selectedTierName Tier</h3>
            </div>
            <div class="space-y-4 text-xs">
                <div>
                    <label class="block text-slate-400 font-bold mb-1">Annual Price (PKR)</label>
                    <input @bind="selectedTierPrice" type="number" class="w-full bg-ink border border-line rounded-xl p-3 text-slate-200 focus:outline-none focus:border-blood-500">
                </div>
                <div>
                    <label class="block text-slate-400 font-bold mb-1">Feature Description</label>
                    <textarea rows="2" class="w-full bg-ink border border-line rounded-xl p-3 text-slate-200 focus:outline-none focus:border-blood-500">Updated package description parameters.</textarea>
                </div>
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-line pt-4">
                <button @onclick="CloseModals" class="px-4 py-2 rounded-xl bg-surface3 hover:bg-line text-slate-300 font-bold text-xs cursor-pointer">Cancel</button>
                <button @onclick="CloseModals" class="px-4 py-2 rounded-xl bg-blood-600 hover:bg-blood-700 text-white font-bold text-xs shadow-md cursor-pointer">Save Tier</button>
            </div>
        </div>
    </div>
}

<!-- REGENERATE API KEY MODAL -->
@if (isRegenModalOpen)
{
    <div class="fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-rose-900/50 w-full max-w-md rounded-2xl shadow-2xl overflow-hidden space-y-6 p-6 relative">
            <button @onclick="CloseModals" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-400 text-lg shrink-0">⚠️</div>
                <div><h3 class="text-base font-bold text-white">Regenerate Master API Key</h3><p class="text-xs text-slate-400 mt-0.5">This will immediately invalidate the current key across all integrations.</p></div>
            </div>
            <div class="flex items-center justify-end gap-3 border-t border-line pt-4">
                <button @onclick="CloseModals" class="px-4 py-2 rounded-xl bg-surface3 hover:bg-line text-slate-300 font-bold text-xs cursor-pointer">Cancel</button>
                <button @onclick="CloseModals" class="px-4 py-2 rounded-xl bg-rose-700 hover:bg-rose-600 text-white font-bold text-xs shadow-md cursor-pointer">Confirm Regenerate</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isMaintenanceMode = false;
    private bool enforce2FA = true;
    private bool autoLockIdle = true;

    private bool isTierModalOpen = false;
    private bool isRegenModalOpen = false;

    private string selectedTierName = "";
    private string selectedTierPrice = "";

    private void ToggleMaintenanceMode()
    {
        isMaintenanceMode = !isMaintenanceMode;
    }

    private void SaveGeneralSettings()
    {
        // General configuration save logic
    }

    private void OpenTierModal(string name, string price)
    {
        selectedTierName = name;
        selectedTierPrice = price;
        isTierModalOpen = true;
    }

    private void OpenRegenModal()
    {
        isRegenModalOpen = true;
    }

    private void CloseModals()
    {
        isTierModalOpen = false;
        isRegenModalOpen = false;
    }
}