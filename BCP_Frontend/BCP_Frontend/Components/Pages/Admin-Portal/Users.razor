@using BCP_Frontend.Components.Layout
@page "/admin/users"
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>Global User Directory — BloodConnect.pk</PageTitle>

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="font-display text-2xl font-bold tracking-tight text-white">Global User Directory</h1>
        <p class="text-xs text-slate-400 mt-1">Manage RBAC roles, security credentials, and identity access across the platform.</p>
    </div>
    <button @onclick="OpenCreateModal" class="bg-gradient-to-r from-blood-600 to-blood-700 hover:from-blood-500 hover:to-blood-600 text-white font-bold text-xs px-4 py-2.5 rounded-xl border border-blood-500/40 shadow-lg shadow-blood-950/50 transition-all flex items-center gap-2 self-start sm:self-auto active:scale-95 cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
        <span>Create System User</span>
    </button>
</div>

<!-- Search & Filters Bar -->
<div class="bg-surface p-4 rounded-2xl border border-line flex flex-col md:flex-row items-center justify-between gap-3 shadow-sm">
    <div class="relative w-full md:w-96">
        <input type="text" placeholder="Search by User Name, Email, or CNIC..." class="w-full bg-ink text-slate-200 text-xs rounded-xl pl-9 pr-4 py-2.5 border border-line focus:outline-none focus:border-blood-500/70 transition-colors">
        <svg class="w-4 h-4 text-slate-500 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    </div>
    <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
        <select class="bg-ink text-slate-300 text-xs rounded-xl px-3 py-2.5 border border-line focus:outline-none focus:border-blood-500/70 font-medium">
            <option value="">All Roles</option>
            <option value="Super Admin">Super Admin</option>
            <option value="Center Admin">Center Admin</option>
            <option value="Blood Donor">Blood Donor</option>
        </select>
        <select class="bg-ink text-slate-300 text-xs rounded-xl px-3 py-2.5 border border-line focus:outline-none focus:border-blood-500/70 font-medium">
            <option value="">Blood Group</option>
            <option value="A+">A+</option>
            <option value="B+">B+</option>
            <option value="O+">O+</option>
            <option value="O-">O-</option>
        </select>
        <select class="bg-ink text-slate-300 text-xs rounded-xl px-3 py-2.5 border border-line focus:outline-none focus:border-blood-500/70 font-medium">
            <option value="active">Active Accounts</option>
            <option value="banned">Banned Users</option>
        </select>
    </div>
</div>

<!-- Users Table -->
<div class="bg-surface border border-line rounded-2xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface2 text-slate-500 text-[11px] font-extrabold uppercase tracking-wider border-b border-line">
                    <th class="py-4 px-5">User Details</th>
                    <th class="py-4 px-4">Role & Access</th>
                    <th class="py-4 px-4 text-center">Group</th>
                    <th class="py-4 px-4">CNIC Number</th>
                    <th class="py-4 px-4">Associated Center</th>
                    <th class="py-4 px-4">Status</th>
                    <th class="py-4 px-5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line text-xs font-medium text-slate-300">

                <!-- Row 1 -->
                <tr class="hover:bg-surface2/60 transition-colors">
                    <td class="py-3.5 px-5">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blood-600/20 to-blood-900/40 border border-blood-500/30 flex items-center justify-center font-bold text-blood-400 text-xs shrink-0">AK</div>
                            <div><p class="font-bold text-white text-sm">Asim Khan</p><p class="text-[11px] text-slate-400 mt-0.5">asim.admin@bloodconnect.pk</p></div>
                        </div>
                    </td>
                    <td class="py-3.5 px-4"><span class="bg-blood-500/10 text-blood-400 border border-blood-500/25 text-[10px] font-black px-2.5 py-1 rounded-md inline-block">Super Admin</span></td>
                    <td class="py-3.5 px-4 text-center"><span class="bg-surface3 text-blood-400 font-mono font-extrabold text-[11px] px-2 py-0.5 rounded border border-line">O+</span></td>
                    <td class="py-3.5 px-4 font-mono text-slate-300">12101-9876543-1</td>
                    <td class="py-3.5 px-4 text-slate-400 italic">System Master HQ</td>
                    <td class="py-3.5 px-4"><span class="bg-vital-500/10 text-vital-400 text-[10px] font-bold px-2.5 py-1 rounded-full border border-vital-500/25 inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-vital-500"></span> Active</span></td>
                    <td class="py-3.5 px-5 text-right">
                        <button @onclick='() => OpenEditModal("Asim Khan", "asim.admin@bloodconnect.pk", "Super Admin")' class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface3 hover:bg-line text-slate-200 hover:text-white text-[11px] font-bold rounded-xl border border-line shadow-sm transition-all active:scale-95 cursor-pointer">
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                            <span>Edit Role</span>
                        </button>
                    </td>
                </tr>

                <!-- Row 2 -->
                <tr class="hover:bg-surface2/60 transition-colors">
                    <td class="py-3.5 px-5">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-ice-600/20 to-ice-950/40 border border-ice-500/30 flex items-center justify-center font-bold text-ice-400 text-xs shrink-0">TM</div>
                            <div><p class="font-bold text-white text-sm">Dr. Tariq Mahmood</p><p class="text-[11px] text-slate-400 mt-0.5">tariq@shaukatkhanum.org.pk</p></div>
                        </div>
                    </td>
                    <td class="py-3.5 px-4"><span class="bg-ice-500/10 text-ice-400 border border-ice-500/25 text-[10px] font-black px-2.5 py-1 rounded-md inline-block">Center Admin</span></td>
                    <td class="py-3.5 px-4 text-center"><span class="bg-surface3 text-blood-400 font-mono font-extrabold text-[11px] px-2 py-0.5 rounded border border-line">B+</span></td>
                    <td class="py-3.5 px-4 font-mono text-slate-300">35202-4412390-3</td>
                    <td class="py-3.5 px-4 font-semibold text-slate-200">Shaukat Khanum Hospital</td>
                    <td class="py-3.5 px-4"><span class="bg-vital-500/10 text-vital-400 text-[10px] font-bold px-2.5 py-1 rounded-full border border-vital-500/25 inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-vital-500"></span> Active</span></td>
                    <td class="py-3.5 px-5 text-right">
                        <div class="inline-flex items-center gap-2">
                            <button @onclick='() => OpenEditModal("Dr. Tariq Mahmood", "tariq@shaukatkhanum.org.pk", "Center Admin")' class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface3 hover:bg-line text-slate-200 hover:text-white text-[11px] font-bold rounded-xl border border-line shadow-sm transition-all active:scale-95 cursor-pointer">
                                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                <span>Manage</span>
                            </button>
                            <button @onclick='() => OpenBanModal("Dr. Tariq Mahmood")' class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-rose-950/80 hover:bg-rose-900 text-rose-300 hover:text-rose-100 text-[11px] font-bold rounded-xl border border-rose-700/50 shadow-sm transition-all active:scale-95 cursor-pointer">
                                <svg class="w-3.5 h-3.5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                                <span>Ban</span>
                            </button>
                        </div>
                    </td>
                </tr>

                <!-- Row 3 -->
                <tr class="hover:bg-surface2/60 transition-colors">
                    <td class="py-3.5 px-5">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-vital-600/20 to-vital-900/40 border border-vital-500/30 flex items-center justify-center font-bold text-vital-400 text-xs shrink-0">MB</div>
                            <div><p class="font-bold text-white text-sm">Muhammad Bilal</p><p class="text-[11px] text-slate-400 mt-0.5">mbilal.pk@gmail.com</p></div>
                        </div>
                    </td>
                    <td class="py-3.5 px-4"><span class="bg-vital-500/10 text-vital-400 border border-vital-500/25 text-[10px] font-black px-2.5 py-1 rounded-md inline-block">Blood Donor</span></td>
                    <td class="py-3.5 px-4 text-center"><span class="bg-surface3 text-blood-400 font-mono font-extrabold text-[11px] px-2 py-0.5 rounded border border-line">AB-</span></td>
                    <td class="py-3.5 px-4 font-mono text-slate-300">17301-5543122-7</td>
                    <td class="py-3.5 px-4 text-slate-400">Independent (Peshawar)</td>
                    <td class="py-3.5 px-4"><span class="bg-vital-500/10 text-vital-400 text-[10px] font-bold px-2.5 py-1 rounded-full border border-vital-500/25 inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-vital-500"></span> Active</span></td>
                    <td class="py-3.5 px-5 text-right">
                        <div class="inline-flex items-center gap-2">
                            <button @onclick='() => OpenEditModal("Muhammad Bilal", "mbilal.pk@gmail.com", "Blood Donor")' class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface3 hover:bg-line text-slate-200 hover:text-white text-[11px] font-bold rounded-xl border border-line shadow-sm transition-all active:scale-95 cursor-pointer">
                                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                <span>Manage</span>
                            </button>
                            <button @onclick='() => OpenBanModal("Muhammad Bilal")' class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-rose-950/80 hover:bg-rose-900 text-rose-300 hover:text-rose-100 text-[11px] font-bold rounded-xl border border-rose-700/50 shadow-sm transition-all active:scale-95 cursor-pointer">
                                <svg class="w-3.5 h-3.5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                                <span>Ban</span>
                            </button>
                        </div>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

    <div class="px-5 py-3.5 bg-surface2 border-t border-line flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400">
        <p>Showing <span class="font-bold text-white">1 to 3</span> of <span class="font-bold text-white">12,450</span> entries</p>
        <div class="flex items-center gap-1.5">
            <button class="px-3 py-1.5 bg-surface3/60 rounded-lg text-slate-600 font-semibold cursor-not-allowed" disabled>Previous</button>
            <button class="px-3 py-1.5 bg-blood-700 text-white font-extrabold rounded-lg shadow-md">1</button>
            <button class="px-3 py-1.5 bg-surface3 hover:bg-line text-slate-300 font-semibold rounded-lg transition-colors cursor-pointer">2</button>
            <button class="px-3 py-1.5 bg-surface3 hover:bg-line text-slate-300 font-semibold rounded-lg transition-colors cursor-pointer">3</button>
            <button class="px-3 py-1.5 bg-surface3 hover:bg-line text-slate-300 font-semibold rounded-lg transition-colors cursor-pointer">Next</button>
        </div>
    </div>
</div>

<!-- MODAL 1: EDIT / MANAGE ROLE MODAL -->
@if (isEditModalOpen)
{
    <div class="fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-line rounded-2xl w-full max-w-md p-6 shadow-2xl relative space-y-5">
            <button @onclick="CloseModals" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <div><h3 class="text-lg font-bold text-white flex items-center gap-2"><span class="text-blood-500">⚙️</span> Manage Role & Security</h3><p class="text-xs text-slate-400 mt-0.5">Update access privilege and authorization claims.</p></div>
            <div class="space-y-4 text-xs">
                <div><label class="block text-slate-400 font-bold mb-1">Target User</label><input type="text" value="@selectedUserName" readonly class="w-full bg-ink/80 text-slate-300 border border-line rounded-xl px-3 py-2.5 font-semibold focus:outline-none cursor-not-allowed"></div>
                <div><label class="block text-slate-400 font-bold mb-1">Email Address</label><input type="email" value="@selectedUserEmail" readonly class="w-full bg-ink/80 text-slate-400 border border-line rounded-xl px-3 py-2.5 focus:outline-none cursor-not-allowed"></div>
                <div>
                    <label class="block text-slate-300 font-bold mb-1">Assigned Role (RBAC Claim)</label>
                    <select class="w-full bg-ink text-white border border-line rounded-xl px-3 py-2.5 focus:border-blood-500/80 focus:outline-none font-bold">
                        <option value="Super Admin">Super Admin (Full Master Privileges)</option>
                        <option value="Center Admin">Center Admin (Hospital/Bank Access)</option>
                        <option value="Blood Donor">Blood Donor (Public Standard User)</option>
                    </select>
                </div>
                <div class="p-3 bg-surface2 rounded-xl border border-line space-y-1">
                    <p class="text-[11px] font-bold text-slate-300">Security Credentials</p>
                    <button @onclick='() => message = "Password reset link sent to user email."' class="text-[11px] text-blood-400 hover:text-blood-300 font-semibold underline cursor-pointer">Send Password Reset Email</button>
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <p class="text-[10px] text-vital-400 mt-1">@message</p>
                    }
                </div>
                <div class="flex items-center justify-end gap-2 pt-2">
                    <button @onclick="CloseModals" class="px-4 py-2 bg-surface3 hover:bg-line text-slate-300 font-bold rounded-xl transition-colors cursor-pointer">Cancel</button>
                    <button @onclick="CloseModals" class="px-4 py-2 bg-gradient-to-r from-blood-600 to-blood-700 hover:from-blood-500 hover:to-blood-600 text-white font-bold rounded-xl shadow-lg shadow-blood-950/50 transition-all cursor-pointer">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL 2: BAN USER MODAL -->
@if (isBanModalOpen)
{
    <div class="fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-rose-900/50 rounded-2xl w-full max-w-md p-6 shadow-2xl relative space-y-5">
            <button @onclick="CloseModals" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-400 text-lg shrink-0">🚫</div>
                <div><h3 class="text-base font-bold text-white">Restrict & Ban User</h3><p class="text-xs text-slate-400 mt-0.5">Revoke active JWT tokens and suspend account access.</p></div>
            </div>
            <div class="space-y-4 text-xs">
                <div><p class="text-slate-300 font-medium">Are you sure you want to ban <span class="font-bold text-white underline">@selectedUserName</span>?</p></div>
                <div>
                    <label class="block text-slate-300 font-bold mb-1">Reason for Ban</label>
                    <select class="w-full bg-ink text-slate-200 border border-line rounded-xl px-3 py-2.5 focus:outline-none focus:border-rose-500">
                        <option value="Fake Emergency Requests">Fake Emergency Requests / Spamming</option>
                        <option value="Identity Fraud (Invalid CNIC)">Identity Fraud (Invalid CNIC)</option>
                        <option value="Abusive Communication">Abusive Communication</option>
                        <option value="Other Policy Violation">Other Policy Violation</option>
                    </select>
                </div>
                <div><label class="block text-slate-300 font-bold mb-1">Admin Notes (Optional)</label><textarea rows="2" placeholder="Internal audit note..." class="w-full bg-ink text-slate-200 border border-line rounded-xl p-2.5 focus:outline-none focus:border-rose-500"></textarea></div>
                <div class="flex items-center justify-end gap-2 pt-2">
                    <button @onclick="CloseModals" class="px-4 py-2 bg-surface3 hover:bg-line text-slate-300 font-bold rounded-xl transition-colors cursor-pointer">Cancel</button>
                    <button @onclick="CloseModals" class="px-4 py-2 bg-rose-700 hover:bg-rose-600 text-white font-bold rounded-xl shadow-lg shadow-rose-950/50 transition-all cursor-pointer">Confirm Ban</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL 3: CREATE SYSTEM USER MODAL -->
@if (isCreateModalOpen)
{
    <div class="fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-line rounded-2xl w-full max-w-lg p-6 shadow-2xl relative space-y-5">
            <button @onclick="CloseModals" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <div><h3 class="text-lg font-bold text-white flex items-center gap-2"><span class="text-blood-500">➕</span> Create System Account</h3><p class="text-xs text-slate-400 mt-0.5">Provision a new Super Admin or Center Admin user manually.</p></div>
            <div class="space-y-3.5 text-xs">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div><label class="block text-slate-300 font-bold mb-1">Full Name</label><input type="text" placeholder="e.g. Dr. Ali Raza" class="w-full bg-ink text-slate-200 border border-line rounded-xl px-3 py-2.5 focus:border-blood-500/80 focus:outline-none"></div>
                    <div><label class="block text-slate-300 font-bold mb-1">CNIC Number</label><input type="text" placeholder="35202-0000000-0" class="w-full bg-ink text-slate-200 border border-line rounded-xl px-3 py-2.5 focus:border-blood-500/80 focus:outline-none"></div>
                </div>
                <div><label class="block text-slate-300 font-bold mb-1">Email Address</label><input type="email" placeholder="user@bloodconnect.pk" class="w-full bg-ink text-slate-200 border border-line rounded-xl px-3 py-2.5 focus:border-blood-500/80 focus:outline-none"></div>
                <div>
                    <label class="block text-slate-300 font-bold mb-1">System Role</label>
                    <select class="w-full bg-ink text-white border border-line rounded-xl px-3 py-2.5 focus:border-blood-500/80 focus:outline-none font-bold">
                        <option value="Super Admin">Super Admin</option>
                        <option value="Center Admin">Center Admin</option>
                    </select>
                </div>
                <div class="flex items-center justify-end gap-2 pt-3">
                    <button @onclick="CloseModals" class="px-4 py-2 bg-surface3 hover:bg-line text-slate-300 font-bold rounded-xl transition-colors cursor-pointer">Cancel</button>
                    <button @onclick="CloseModals" class="px-4 py-2 bg-gradient-to-r from-blood-600 to-blood-700 hover:from-blood-500 hover:to-blood-600 text-white font-bold rounded-xl shadow-lg shadow-blood-950/50 transition-all cursor-pointer">Provision Account</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isEditModalOpen = false;
    private bool isBanModalOpen = false;
    private bool isCreateModalOpen = false;
    private string selectedUserName = "";
    private string selectedUserEmail = "";
    private string message = "";

    private void OpenEditModal(string name, string email, string role)
    {
        selectedUserName = name;
        selectedUserEmail = email;
        message = "";
        isEditModalOpen = true;
    }

    private void OpenBanModal(string name)
    {
        selectedUserName = name;
        isBanModalOpen = true;
    }

    private void OpenCreateModal()
    {
        isCreateModalOpen = true;
    }

    private void CloseModals()
    {
        isEditModalOpen = false;
        isBanModalOpen = false;
        isCreateModalOpen = false;
    }
}