@using BCP_Frontend.Components.Layout
@using BCP_BL.Shared

@page "/admin/all-centers"
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>Registered Centers Directory — BloodConnect.pk</PageTitle>

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="font-display text-2xl font-bold tracking-tight text-white">Registered Centers Directory</h1>
        <p class="text-xs text-slate-400 mt-1">Manage active blood banks, monitor stock levels, manage SaaS subscriptions, and freeze/activate accounts.</p>
    </div>
    <div class="flex items-center gap-3 text-xs">
        <div class="bg-surface border border-line px-3.5 py-2 rounded-xl text-center">
            <span class="text-slate-500 block text-[10px] uppercase font-bold">Total Centers</span>
            <span class="text-white font-extrabold text-sm">@totalCenters</span>
        </div>
        <div class="bg-surface border border-line px-3.5 py-2 rounded-xl text-center">
            <span class="text-slate-500 block text-[10px] uppercase font-bold">Approved</span>
            <span class="text-vital-400 font-extrabold text-sm">@approvedCenters</span>
        </div>
        <div class="bg-surface border border-line px-3.5 py-2 rounded-xl text-center">
            <span class="text-slate-500 block text-[10px] uppercase font-bold">Suspended</span>
            <span class="text-rose-400 font-extrabold text-sm">@suspendedCenters</span>
        </div>
    </div>
</div>

<!-- Search & Filters Bar -->
<div class="bg-surface p-4 rounded-2xl border border-line flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="relative w-full md:w-96">
        <input type="text"
               placeholder="Search center, license, or city..."
               class="w-full bg-ink text-slate-100 text-xs rounded-xl pl-9 pr-4 py-2.5 border border-line focus:outline-none focus:border-blood-500 transition-colors"
               @bind="searchTerm"
               @bind:event="oninput">
        <svg class="w-4 h-4 text-slate-500 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
    </div>
    <div class="flex items-center gap-2 w-full md:w-auto flex-wrap">
        <select class="bg-ink text-slate-300 text-xs rounded-xl px-3 py-2.5 border border-line focus:outline-none focus:border-blood-500" @bind="selectedProvince">
            <option value="">All Provinces</option>
            <option value="punjab">Punjab</option>
            <option value="sindh">Sindh</option>
            <option value="kp">Khyber Pakhtunkhwa</option>
            <option value="balochistan">Balochistan</option>
            <option value="ict">Islamabad (ICT)</option>
        </select>
        <select class="bg-ink text-slate-300 text-xs rounded-xl px-3 py-2.5 border border-line focus:outline-none focus:border-blood-500" @bind="selectedTier">
            <option value="">All SaaS Tiers</option>
            <option value="enterprise">Enterprise</option>
            <option value="professional">Professional</option>
            <option value="standard">Standard</option>
        </select>
        <select class="bg-ink text-slate-300 text-xs rounded-xl px-3 py-2.5 border border-line focus:outline-none focus:border-blood-500" @bind="selectedStatus">
            <option value="@BloodCenterStatus.Pending">All Status</option>
            <option value="@BloodCenterStatus.Pending">Pending</option>
            <option value="@BloodCenterStatus.Approved">Approved</option>
            <option value="@BloodCenterStatus.Active">Active</option>
            <option value="@BloodCenterStatus.Suspended">Suspended</option>
            <option value="@BloodCenterStatus.Freeze">Freeze</option>
            <option value="@BloodCenterStatus.UnFreeze">UnFreeze</option>
        </select>
        <button class="bg-blood-600 hover:bg-blood-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition-colors" @onclick="ApplyFilters">Apply Filters</button>
        <button class="bg-surface3 hover:bg-line text-slate-300 text-xs font-bold px-4 py-2.5 rounded-xl transition-colors" @onclick="ResetFilters">Reset</button>
    </div>
</div>

<!-- Loading State -->
@if (isLoading)
{
    <div class="flex items-center justify-center py-20">
        <div class="text-center">
            <div class="w-12 h-12 border-4 border-blood-500 border-t-transparent rounded-full animate-spin mx-auto"></div>
            <p class="text-slate-400 text-sm mt-4">Loading centers...</p>
        </div>
    </div>
}

<!-- Error State -->
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="bg-rose-950/30 border border-rose-500/30 rounded-2xl p-6 text-center">
        <p class="text-rose-400 font-bold">⚠️ @errorMessage</p>
        <button class="mt-3 bg-blood-600 hover:bg-blood-700 text-white text-xs font-bold px-4 py-2 rounded-xl" @onclick="LoadCenters">Retry</button>
    </div>
}

<!-- Centers Table -->
@if (!isLoading && filteredCenters.Any())
{
    <div class="bg-surface rounded-2xl border border-line overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="bg-surface2 text-slate-500 font-bold uppercase tracking-wider border-b border-line text-[10px]">
                        <th class="p-4">Center Info & License</th>
                        <th class="p-4">Contact</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line font-medium">
                    @foreach (var center in filteredCenters)
                    {
                        var isSuspended = center.Status == BloodCenterStatus.Suspended || center.Status == BloodCenterStatus.Freeze;
                        var statusClass = isSuspended ? "rose-400" : "vital-400";
                        var statusLabel = center.Status.ToString();

                        <tr class="hover:bg-surface2/60 transition-colors @(isSuspended ? "bg-rose-950/10" : "")">
                            <td class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl @(isSuspended ? "bg-rose-500/10 border-rose-500/25" : "bg-vital-500/10 border-vital-500/25") border flex items-center justify-center font-extrabold text-base shrink-0">
                                        @if (!string.IsNullOrEmpty(center.ImageUrl))
                                        {
                                            <img src="@center.ImageUrl" alt="@center.Name" class="w-8 h-8 rounded-lg object-cover" />
                                        }
                                        else
                                        {
                                            @(isSuspended ? "🚫" : "🏥")
                                        }
                                    </div>
                                    <div>
                                        <p class="font-bold text-white text-sm">@center.Name</p>
                                        <p class="text-[11px] font-mono text-slate-500">License: @center.RegistrationNumber</p>
                                        <p class="text-[11px] text-slate-500">@center.Address</p>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4">
                                <p class="text-slate-200 text-sm">@center.ContactPhone</p>
                                <p class="text-[11px] text-slate-500">Emergency: @center.EmergencyPhone</p>
                            </td>
                            <td class="p-4">
                                <div class="flex flex-col gap-1">
                                    <span class="bg-@(statusClass)-10 text-@(statusClass) text-[11px] font-bold px-2.5 py-1 rounded-full border border-@(statusClass)-25 inline-flex items-center gap-1.5">
                                        <span class="w-1.5 h-1.5 rounded-full bg-@(statusClass)"></span>
                                        @statusLabel
                                    </span>
                                    @if (center.IsVerified)
                                    {
                                        <span class="text-emerald-400 text-[10px] font-bold">✓ Verified</span>
                                    }
                                    @if (!center.IsActive)
                                    {
                                        <span class="text-amber-400 text-[10px] font-bold">⚠️ Inactive</span>
                                    }
                                </div>
                            </td>
                            <td class="p-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <button @onclick='() => OpenManageModal(center)'
                                            class="bg-surface3 hover:bg-line text-slate-200 text-xs font-bold px-3 py-1.5 rounded-lg border border-line cursor-pointer">
                                        Manage
                                    </button>
                                    @if (isSuspended)
                                    {
                                        <button @onclick='() => UnfreezeCenter(center.Id)'
                                                class="bg-emerald-950 hover:bg-emerald-900 text-emerald-300 text-xs font-bold px-2.5 py-1.5 rounded-lg border border-emerald-800/50 cursor-pointer">
                                            Unfreeze
                                        </button>
                                    }
                                    else
                                    {
                                        <button @onclick='() => OpenFreezeModal(center)'
                                                class="bg-rose-950 hover:bg-rose-900 text-rose-300 text-xs font-bold px-2.5 py-1.5 rounded-lg border border-rose-800/50 cursor-pointer">
                                            Freeze
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="p-4 border-t border-line flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400">
            <p>
                Showing <span class="font-bold text-white">@((currentPage - 1) * pageSize + 1)</span>
                to <span class="font-bold text-white">@Math.Min(currentPage * pageSize, filteredCenters.Count)</span>
                of <span class="font-bold text-white">@filteredCenters.Count</span> Centers
            </p>
            <div class="flex items-center gap-2">
                <button class="px-3 py-1.5 bg-surface3 hover:bg-line text-slate-200 rounded-lg cursor-pointer"
                        disabled="@(currentPage <= 1)"
                        @onclick="PreviousPage">
                    Previous
                </button>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <button class="px-3 py-1.5 rounded-lg cursor-pointer @(i == currentPage ? "bg-blood-700 text-white font-bold" : "bg-surface3 hover:bg-line text-slate-200")"
                            @onclick='() => GoToPage(i)'>
                        @i
                    </button>
                }
                <button class="px-3 py-1.5 bg-surface3 hover:bg-line text-slate-200 rounded-lg cursor-pointer"
                        disabled="@(currentPage >= totalPages)"
                        @onclick="NextPage">
                    Next
                </button>
            </div>
        </div>
    </div>
}
else if (!isLoading && !filteredCenters.Any())
{
    <div class="bg-surface rounded-2xl border border-line p-12 text-center">
        <p class="text-slate-400">No centers found matching your criteria.</p>
    </div>
}

<!-- Manage Center Modal -->
@if (isManageModalOpen && selectedCenter != null)
{
    <div class="fixed inset-0 bg-ink/70 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface border border-line w-full max-w-xl rounded-2xl shadow-2xl overflow-hidden space-y-6 p-6">
            <div class="flex items-center justify-between border-b border-line pb-4">
                <div class="flex items-center gap-2.5">
                    <div class="w-10 h-10 rounded-xl bg-surface3 border border-line flex items-center justify-center overflow-hidden">
                        @if (!string.IsNullOrEmpty(selectedCenter.ImageUrl))
                        {
                            <img src="@selectedCenter.ImageUrl" alt="@selectedCenter.Name" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <span class="text-white text-base">🏢</span>
                        }
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-white">@selectedCenter.Name</h3>
                        <p class="text-xs font-mono text-slate-400">License: @selectedCenter.RegistrationNumber</p>
                    </div>
                </div>
                <button @onclick="CloseModals" class="text-slate-400 hover:text-white text-lg font-bold cursor-pointer">✕</button>
            </div>

            <div class="space-y-4 text-xs">
                <div class="grid grid-cols-2 gap-3 bg-ink p-4 rounded-xl border border-line">
                    <div>
                        <span class="text-slate-500 text-[10px] uppercase font-bold">Current Status</span>
                        <p class="@(selectedCenter.Status == BloodCenterStatus.Approved ? "text-vital-400" : "text-rose-400") font-extrabold text-sm mt-0.5">
                            @selectedCenter.Status
                        </p>
                    </div>
                    <div>
                        <span class="text-slate-500 text-[10px] uppercase font-bold">Verified</span>
                        <p class="text-white font-bold text-xs mt-0.5">@(selectedCenter.IsVerified ? "✅ Yes" : "❌ No")</p>
                    </div>
                    <div>
                        <span class="text-slate-500 text-[10px] uppercase font-bold">Active</span>
                        <p class="text-white font-bold text-xs mt-0.5">@(selectedCenter.IsActive ? "✅ Yes" : "❌ No")</p>
                    </div>
                    <div>
                        <span class="text-slate-500 text-[10px] uppercase font-bold">Contact</span>
                        <p class="text-white font-bold text-xs mt-0.5">@selectedCenter.ContactPhone</p>
                    </div>
                </div>

                <div>
                    <label class="block text-slate-400 font-bold">Update Center Status</label>
                    <select class="w-full bg-ink border border-line rounded-xl p-3 text-slate-200 focus:outline-none focus:border-blood-500" @bind="selectedStatus">
                        <option value="@BloodCenterStatus.Pending">Pending</option>
                        <option value="@BloodCenterStatus.Approved">Approved</option>
                        <option value="@BloodCenterStatus.Active">Active</option>
                        <option value="@BloodCenterStatus.Suspended">Suspended</option>
                        <option value="@BloodCenterStatus.Freeze">Freeze</option>
                        <option value="@BloodCenterStatus.UnFreeze">UnFreeze</option>
                    </select>
                </div>

                <div>
                    <label class="block text-slate-400 font-bold mb-1">Administrative Remarks</label>
                    <textarea rows="2"
                              placeholder="Notes on plan upgrade, license renewals, or contact changes..."
                              class="w-full bg-ink border border-line rounded-xl p-3 text-slate-200 focus:outline-none focus:border-blood-500"
                              @bind="adminRemarks">
                    </textarea>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 border-t border-line pt-4">
                <button @onclick="CloseModals"
                        class="px-4 py-2 rounded-xl bg-surface3 hover:bg-line text-slate-300 font-bold text-xs cursor-pointer">
                    Cancel
                </button>
                <button @onclick="UpdateCenter"
                        class="px-4 py-2 rounded-xl bg-blood-600 hover:bg-blood-700 text-white font-bold text-xs shadow-md cursor-pointer">
                    Save Center Settings
                </button>
            </div>
        </div>
    </div>
}

<!-- Freeze/Suspend Modal -->
@if (isFreezeModalOpen && selectedCenter != null)
{
    <div class="fixed inset-0 bg-ink/70 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface border border-line w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden space-y-6 p-6">
            <div class="flex items-center justify-between border-b border-line pb-4">
                <div class="flex items-center gap-2.5">
                    <span class="p-2 rounded-xl bg-rose-500/10 text-rose-400 text-base">⚠️</span>
                    <div>
                        <h3 class="text-base font-bold text-white">Freeze Center Account</h3>
                        <p class="text-xs text-slate-400">Center: @selectedCenter.Name</p>
                    </div>
                </div>
                <button @onclick="CloseModals" class="text-slate-400 hover:text-white text-lg font-bold cursor-pointer">✕</button>
            </div>

            <div class="space-y-4 text-xs">
                <div class="p-4 bg-rose-500/10 border border-rose-500/25 rounded-xl space-y-1">
                    <p class="font-bold text-rose-300">Warning</p>
                    <p class="text-slate-300">Freezing this account will immediately disable login access for center staff and hide their blood inventory from global emergency searches.</p>
                </div>

                <div>
                    <label class="block text-slate-400 font-bold mb-1">Reason for Suspension</label>
                    <select class="w-full bg-ink border border-line rounded-xl p-3 text-slate-200 focus:outline-none focus:border-rose-500" @bind="freezeReason">
                        <option value="SaaS Subscription Payment Overdue">SaaS Subscription Payment Overdue</option>
                        <option value="Expired Provincial Health Regulatory License">Expired Provincial Health Regulatory License</option>
                        <option value="Compliance Violation / Reported Quality Issues">Compliance Violation / Reported Quality Issues</option>
                        <option value="Temporary Suspension requested by Center">Temporary Suspension requested by Center</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 border-t border-line pt-4">
                <button @onclick="CloseModals"
                        class="px-4 py-2 rounded-xl bg-surface3 hover:bg-line text-slate-300 font-bold text-xs cursor-pointer">
                    Cancel
                </button>
                <button @onclick="FreezeCenter"
                        class="px-4 py-2 rounded-xl bg-rose-700 hover:bg-rose-600 text-white font-bold text-xs shadow-md cursor-pointer">
                    Confirm Account Freeze
                </button>
            </div>
        </div>
    </div>
}