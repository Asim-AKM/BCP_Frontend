@using BCP_Frontend.Components.Layout
@page "/admin/system-logs"
@layout AdminLayout
@rendermode InteractiveServer

<PageTitle>Security & Audit Logs — BloodConnect.pk</PageTitle>

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="font-display text-2xl font-bold tracking-tight text-white">Security & Audit Logs</h1>
        <p class="text-xs text-slate-400 mt-1">Real-time system telemetry, API endpoint activity, and privilege events.</p>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto">
        <button @onclick="ExportLogsCSV" class="bg-surface3 hover:bg-line text-slate-200 font-bold text-xs px-3.5 py-2 rounded-xl border border-line transition-all flex items-center gap-2 active:scale-95 cursor-pointer">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            <span>Export CSV</span>
        </button>
        <button @onclick="OpenPurgeModal" class="bg-rose-950 hover:bg-rose-900 text-rose-300 font-bold text-xs px-3.5 py-2 rounded-xl border border-rose-800/50 transition-all flex items-center gap-2 active:scale-95 cursor-pointer">
            <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            <span>Purge Logs</span>
        </button>
    </div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-surface p-4 rounded-2xl border border-line">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Total Events Today</p>
        <p class="font-display text-xl font-bold text-white mt-1">14,892</p>
    </div>
    <div class="bg-surface p-4 rounded-2xl border border-line">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Security Alerts</p>
        <p class="font-display text-xl font-bold text-signal-400 mt-1">12</p>
    </div>
    <div class="bg-surface p-4 rounded-2xl border border-line">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Failed Auth Attempts</p>
        <p class="font-display text-xl font-bold text-rose-400 mt-1">3</p>
    </div>
    <div class="bg-surface p-4 rounded-2xl border border-line">
        <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Avg Response Time</p>
        <p class="font-display text-xl font-bold text-vital-400 mt-1">42ms</p>
    </div>
</div>

<div class="bg-surface p-4 rounded-2xl border border-line flex flex-col md:flex-row items-center justify-between gap-3 shadow-sm">
    <div class="relative w-full md:w-96">
        <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Search IP, Endpoint, Actor, or Message..." class="w-full bg-ink text-slate-200 text-xs rounded-xl pl-9 pr-4 py-2.5 border border-line focus:outline-none focus:border-blood-500/70 transition-colors">
        <svg class="w-4 h-4 text-slate-500 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    </div>
    <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-1 md:pb-0">
        <select @bind="selectedLevel" class="bg-ink text-slate-300 text-xs rounded-xl px-3 py-2.5 border border-line focus:outline-none focus:border-blood-500/70 font-medium">
            <option value="ALL">All Severity Levels</option>
            <option value="SECURITY">SECURITY Audit</option>
            <option value="WARN">WARN Severity</option>
            <option value="INFO">INFO Level</option>
            <option value="ERROR">ERROR / Exceptions</option>
        </select>
        <select @bind="selectedCategory" class="bg-ink text-slate-300 text-xs rounded-xl px-3 py-2.5 border border-line focus:outline-none focus:border-blood-500/70 font-medium">
            <option value="ALL">All Categories</option>
            <option value="AUTH">Authentication</option>
            <option value="RBAC">RBAC & Authorization</option>
            <option value="API">REST API Core</option>
            <option value="CENTER">Center Verification</option>
        </select>
    </div>
</div>

<div class="bg-surface border border-line rounded-2xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface2 text-slate-500 text-[11px] font-extrabold uppercase tracking-wider border-b border-line">
                    <th class="py-4 px-5">Timestamp</th>
                    <th class="py-4 px-4">Level</th>
                    <th class="py-4 px-4">Category</th>
                    <th class="py-4 px-4">Actor / Identity</th>
                    <th class="py-4 px-4">IP Address</th>
                    <th class="py-4 px-5">Event Detail</th>
                    <th class="py-4 px-4 text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line text-xs font-medium text-slate-300">
                @foreach (var log in FilteredLogs)
                {
                    <tr class="hover:bg-surface2/60 transition-colors">
                        <td class="py-3.5 px-5 font-mono text-[11px] text-slate-400 whitespace-nowrap">@log.Timestamp</td>
                        <td class="py-3.5 px-4">
                            @if (log.Level == "SECURITY")
                            {
                                <span class="bg-blood-500/10 text-blood-400 border border-blood-500/25 text-[10px] font-black px-2.5 py-0.5 rounded inline-block">SECURITY</span>
                            }
                            else if (log.Level == "WARN")
                            {
                                <span class="bg-signal-500/10 text-signal-400 border border-signal-500/25 text-[10px] font-black px-2.5 py-0.5 rounded inline-block">WARN</span>
                            }
                            else if (log.Level == "INFO")
                            {
                                <span class="bg-ice-500/10 text-ice-400 border border-ice-500/25 text-[10px] font-black px-2.5 py-0.5 rounded inline-block">INFO</span>
                            }
                            else if (log.Level == "ERROR")
                            {
                                <span class="bg-rose-500/10 text-rose-400 border border-rose-500/25 text-[10px] font-black px-2.5 py-0.5 rounded inline-block">ERROR</span>
                            }
                        </td>
                        <td class="py-3.5 px-4 font-bold text-slate-300">@log.Category</td>
                        <td class="py-3.5 px-4 font-semibold @(log.Level == "WARN" || log.Level == "ERROR" ? "text-slate-400" : "text-white")">@log.Actor</td>
                        <td class="py-3.5 px-4 font-mono text-slate-400">@log.IpAddress</td>
                        <td class="py-3.5 px-5 @(log.Level == "ERROR" ? "text-rose-300" : log.Level == "WARN" ? "text-signal-300" : "text-slate-200")">@log.Message</td>
                        <td class="py-3.5 px-4 text-right">
                            <button @onclick="() => ViewLogDetail(log)" class="px-2.5 py-1 bg-surface3 hover:bg-line text-slate-300 rounded-lg text-[11px] font-bold border border-line transition-colors cursor-pointer">Details</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="px-5 py-3.5 bg-surface2 border-t border-line flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400">
        <p>Showing <span class="font-bold text-white">@FilteredLogs.Count()</span> of <span class="font-bold text-white">14,892</span> audit entries</p>
        <div class="flex items-center gap-1.5">
            <button class="px-3 py-1.5 bg-surface3/60 rounded-lg text-slate-600 font-semibold cursor-not-allowed" disabled>Previous</button>
            <button class="px-3 py-1.5 bg-blood-700 text-white font-extrabold rounded-lg shadow-md">1</button>
            <button class="px-3 py-1.5 bg-surface3 hover:bg-line text-slate-300 font-semibold rounded-lg transition-colors cursor-pointer">2</button>
            <button class="px-3 py-1.5 bg-surface3 hover:bg-line text-slate-300 font-semibold rounded-lg transition-colors cursor-pointer">Next</button>
        </div>
    </div>
</div>

<!-- LOG DETAIL MODAL -->
@if (isDetailModalOpen)
{
    <div class="fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-line rounded-2xl w-full max-w-lg p-6 shadow-2xl relative space-y-4">
            <button @onclick="CloseModals" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-blood-900/40 border border-blood-700/50 flex items-center justify-center text-blood-400 text-sm font-black">📜</div>
                <div><h3 class="text-base font-bold text-white">Audit Log Inspection</h3><p class="text-xs font-mono text-slate-400">@selectedLog?.Id</p></div>
            </div>
            <div class="space-y-3 text-xs bg-ink p-4 rounded-xl border border-line">
                <div class="grid grid-cols-2 gap-2">
                    <div><p class="text-slate-500 font-bold uppercase text-[10px]">Timestamp</p><p class="text-slate-200 font-mono mt-0.5">@selectedLog?.Timestamp</p></div>
                    <div><p class="text-slate-500 font-bold uppercase text-[10px]">Client IP</p><p class="text-slate-200 font-mono mt-0.5">@selectedLog?.IpAddress</p></div>
                </div>
                <div><p class="text-slate-500 font-bold uppercase text-[10px]">Actor Principal</p><p class="text-white font-semibold mt-0.5">@selectedLog?.Actor</p></div>
                <div><p class="text-slate-500 font-bold uppercase text-[10px]">Log Message Payload</p><p class="text-slate-300 font-mono bg-surface p-2.5 rounded-lg border border-line mt-1 break-all">@selectedLog?.Message</p></div>
            </div>
            <div class="flex items-center justify-end pt-2">
                <button @onclick="CloseModals" class="px-4 py-2 bg-surface3 hover:bg-line text-slate-300 font-bold rounded-xl transition-colors text-xs cursor-pointer">Close Inspection</button>
            </div>
        </div>
    </div>
}

<!-- PURGE CONFIRMATION MODAL -->
@if (isPurgeModalOpen)
{
    <div class="fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-rose-900/50 rounded-2xl w-full max-w-md p-6 shadow-2xl relative space-y-5">
            <button @onclick="CloseModals" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-400 text-lg shrink-0">🗑️</div>
                <div><h3 class="text-base font-bold text-white">Purge System Logs</h3><p class="text-xs text-slate-400 mt-0.5">Clear historical telemetry and older audit records.</p></div>
            </div>
            <p class="text-xs text-slate-300">Are you sure you want to purge system logs older than 30 days?</p>
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <p class="text-xs text-vital-400 font-semibold">@statusMessage</p>
            }
            <div class="flex items-center justify-end gap-2 pt-2">
                <button @onclick="CloseModals" class="px-4 py-2 bg-surface3 hover:bg-line text-slate-300 font-bold rounded-xl transition-colors text-xs cursor-pointer">Cancel</button>
                <button @onclick="ConfirmPurge" class="px-4 py-2 bg-rose-700 hover:bg-rose-600 text-white font-bold rounded-xl shadow-lg shadow-rose-950/50 transition-all text-xs cursor-pointer">Confirm Purge</button>
            </div>
        </div>
    </div>
}

@code {
    private string searchQuery = "";
    private string selectedLevel = "ALL";
    private string selectedCategory = "ALL";

    private bool isDetailModalOpen = false;
    private bool isPurgeModalOpen = false;
    private string statusMessage = "";

    private AuditLogModel? selectedLog;

    private class AuditLogModel
    {
        public string Id { get; set; } = "";
        public string Timestamp { get; set; } = "";
        public string Level { get; set; } = "";
        public string Category { get; set; } = "";
        public string Actor { get; set; } = "";
        public string IpAddress { get; set; } = "";
        public string Message { get; set; } = "";
    }

    private List<AuditLogModel> logs = new()
    {
        new() { Id = "LOG-99210", Timestamp = "2026-08-16 13:42:10", Level = "SECURITY", Category = "RBAC", Actor = "Asim Khan (Super Admin)", IpAddress = "103.255.4.12", Message = "Changed role claim for user Dr. Tariq Mahmood to Center Admin" },
        new() { Id = "LOG-99209", Timestamp = "2026-08-16 13:38:05", Level = "WARN", Category = "AUTH", Actor = "usman.fake@yahoo.com", IpAddress = "39.44.112.98", Message = "Invalid password attempt. Suspicious login rate detected." },
        new() { Id = "LOG-99208", Timestamp = "2026-08-16 13:15:44", Level = "INFO", Category = "CENTER", Actor = "System Approval Engine", IpAddress = "127.0.0.1", Message = "Approved center registration request for Sundas Foundation Lahore" },
        new() { Id = "LOG-99207", Timestamp = "2026-08-16 12:50:11", Level = "ERROR", Category = "API", Actor = "System Gateway", IpAddress = "10.0.0.5", Message = "SMS Gateway Timeout (HTTP 504) while dispatching emergency broadcast alert." },
        new() { Id = "LOG-99206", Timestamp = "2026-08-16 12:05:00", Level = "INFO", Category = "AUTH", Actor = "Muhammad Bilal", IpAddress = "111.68.99.14", Message = "Successful JWT Token Issuance via Blazor Web Client." }
    };

    private IEnumerable<AuditLogModel> FilteredLogs => logs.Where(log =>
    {
        bool matchesSearch = string.IsNullOrWhiteSpace(searchQuery) ||
            log.Actor.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            log.Message.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            log.IpAddress.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            log.Id.Contains(searchQuery, StringComparison.OrdinalIgnoreCase);

        bool matchesLevel = selectedLevel == "ALL" || log.Level == selectedLevel;
        bool matchesCategory = selectedCategory == "ALL" || log.Category == selectedCategory;

        return matchesSearch && matchesLevel && matchesCategory;
    });

    private void ViewLogDetail(AuditLogModel log)
    {
        selectedLog = log;
        isDetailModalOpen = true;
    }

    private void OpenPurgeModal()
    {
        statusMessage = "";
        isPurgeModalOpen = true;
    }

    private void ConfirmPurge()
    {
        statusMessage = "Old telemetry and logs successfully purged.";
        Task.Delay(1500).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                isPurgeModalOpen = false;
                StateHasChanged();
            });
        });
    }

    private void ExportLogsCSV()
    {
        // Add export logic or JS interop download handling
    }

    private void CloseModals()
    {
        isDetailModalOpen = false;
        isPurgeModalOpen = false;
    }
}